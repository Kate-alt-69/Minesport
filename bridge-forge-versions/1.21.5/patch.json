{
  "schema": 1,
  "description": "Adapt the canonical Forge 1.21.10 Bridge to Minecraft 1.21.5 / Forge 55.1.13, including the older collectParts output-list API.",
  "operations": [
    {"op": "set_property", "file": "gradle.properties", "key": "minecraft_version", "value": "${minecraft_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "forge_version", "value": "${forge_version}"},
    {"op": "replace", "file": "src/main/resources/META-INF/mods.toml", "from": "loaderVersion=\"[60,)\"", "to": "loaderVersion=\"[55,)\""},
    {"op": "replace", "file": "src/main/resources/META-INF/mods.toml", "from": "versionRange=\"[60.1.0,)\"", "to": "versionRange=\"[55.1.0,)\""},
    {"op": "replace", "file": "src/main/resources/META-INF/mods.toml", "from": "versionRange=\"[1.21.10,1.21.11)\"", "to": "versionRange=\"[1.21.5,1.21.6)\""},
    {"op": "overlay", "source": "1.21.5/BlockGeometryExtractor.java", "target": "src/main/java/dev/kastrick/minesport/bridge/registry/BlockGeometryExtractor.java"}
  ]
}
