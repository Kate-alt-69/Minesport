import { ProgressIndicator } from "std-widgets.slint";

// Reusable Minesport loading surface.
//
// Working loop:
//   9 constant-size dots orbit -> collapse -> one large center mass -> the
//   center mass shrinks while ejecting the same 9 normal-size dots -> orbit.
// Completion:
//   dots collapse -> center mass -> an 8x8 monochrome pixel creeper-face mark
//   assembles from the center -> hold -> fade. Callers own placement and may
//   keep their host alive until `finished()` fires.
export component MinesportLoader inherits Rectangle {
    in property <bool> active: false;
    in property <string> title: "Working…";
    in property <string> detail: "";
    in property <float> progress: 0.0;
    in property <bool> determinate: false;
    in property <bool> compact: false;
    // Long-running background jobs can disable the 60-FPS orbit while keeping
    // the same progress surface. Progress/property updates still repaint.
    in property <bool> animate-working: true;
    out property <bool> finishing: false;
    callback finished();

    private property <float> cycle: 0.0;
    private property <bool> was-active: root.active;
    private property <int> finish-step: 0;

    min-width: root.compact ? 240px : 340px;
    preferred-width: root.compact ? 330px : 460px;
    min-height: root.compact ? 76px : 106px;
    preferred-height: root.compact ? 82px : 120px;
    visible: root.active || root.finishing;
    opacity: root.finish-step >= 4 ? 0.0 : 1.0;
    background: #141817f2;
    border-width: 1px;
    border-color: #3b453f;
    border-radius: 9px;

    animate opacity {
        duration: 190ms;
        easing: ease-out;
    }

    changed active => {
        if (root.active) {
            root.was-active = true;
            root.finishing = false;
            root.finish-step = 0;
            root.cycle = 0.0;
            finish-timer.running = false;
        } else if (root.was-active) {
            root.was-active = false;
            root.finishing = true;
            root.finish-step = 1;
            finish-timer.running = true;
        }
    }

    orbit-timer := Timer {
        interval: 16ms;
        running: root.active && root.animate-working;
        triggered() => {
            root.cycle = mod(root.cycle + 0.0089, 1.0);
        }
    }

    finish-timer := Timer {
        interval: 190ms;
        running: false;
        triggered() => {
            if (!root.finishing) {
                self.running = false;
            } else if (root.finish-step < 5) {
                root.finish-step += 1;
            } else {
                root.finishing = false;
                root.finish-step = 0;
                self.running = false;
                root.finished();
            }
        }
    }

    function working-radius() -> length {
        let p = root.cycle;
        if (p < 0.54) {
            return 21px;
        }
        if (p < 0.70) {
            let t = (p - 0.54) / 0.16;
            return 21px * (1.0 - t);
        }
        let t = (p - 0.70) / 0.30;
        return 21px * t;
    }

    function center-mass-size() -> length {
        if (root.finishing && root.finish-step == 1) {
            return 30px;
        }
        if (!root.active || root.cycle < 0.70) {
            return 0px;
        }
        let t = (root.cycle - 0.70) / 0.30;
        return 30px * (1.0 - t);
    }

    function dot-x(index: int) -> length {
        if (root.finishing) {
            return 29px;
        }
        let angle = index * 40deg + root.cycle * 600deg;
        return 29px + cos(angle) * root.working-radius();
    }

    function dot-y(index: int) -> length {
        if (root.finishing) {
            return 29px;
        }
        let angle = index * 40deg + root.cycle * 600deg;
        return 29px + sin(angle) * root.working-radius();
    }

    function pixel-column(index: int) -> int {
        return mod(index, 8);
    }

    function pixel-row(index: int) -> int {
        return floor(index / 8);
    }

    function face-pixel-black(index: int) -> bool {
        let row = root.pixel-row(index);
        let col = root.pixel-column(index);
        if ((row == 1 || row == 2) && ((col >= 1 && col <= 2) || (col >= 5 && col <= 6))) {
            return true;
        }
        if (row == 3 && (col == 3 || col == 4)) {
            return true;
        }
        if ((row == 4 || row == 5) && col >= 2 && col <= 5) {
            return true;
        }
        if (row == 6 && (col == 2 || col == 5)) {
            return true;
        }
        if (row == 7 && ((col >= 1 && col <= 2) || (col >= 5 && col <= 6))) {
            return true;
        }
        return false;
    }

    function pixel-x(index: int) -> length {
        if (root.finish-step <= 1) { return 30px; }
        return 6px + root.pixel-column(index) * 6px;
    }

    function pixel-y(index: int) -> length {
        if (root.finish-step <= 1) { return 30px; }
        return 6px + root.pixel-row(index) * 6px;
    }

    HorizontalLayout {
        padding: root.compact ? 10px : 14px;
        spacing: root.compact ? 10px : 14px;
        cross-axis-alignment: center;

        indicator := Rectangle {
            width: 64px;
            height: 64px;
            background: transparent;

            center-mass := Rectangle {
                width: root.center-mass-size();
                height: self.width;
                x: 32px - self.width / 2;
                y: 32px - self.height / 2;
                border-radius: self.width / 2;
                background: #f2f4f3;
                visible: self.width > 0px;
            }

            for dot[index] in 9: Rectangle {
                x: root.dot-x(index);
                y: root.dot-y(index);
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: #f2f4f3;
                visible: !root.finishing || root.finish-step <= 1;

                animate x, y {
                    duration: 145ms;
                    easing: ease-in-out;
                    enabled: root.finishing;
                }
            }

            for pixel[index] in 64: Rectangle {
                x: root.pixel-x(index);
                y: root.pixel-y(index);
                width: 5px;
                height: 5px;
                border-radius: 0px;
                background: root.face-pixel-black(index) ? #080a09 : #f3f5f4;
                visible: root.finishing && root.finish-step >= 2 && root.finish-step < 5;

                animate x, y {
                    duration: 170ms;
                    easing: ease-out;
                    enabled: root.finishing;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: root.compact ? 3px : 6px;
            Text {
                text: root.title;
                color: #eef2ef;
                font-size: root.compact ? 12px : 14px;
                font-weight: 700;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: #aeb8b2;
                font-size: root.compact ? 10px : 11px;
                wrap: word-wrap;
                overflow: elide;
            }
            if root.determinate: HorizontalLayout {
                spacing: 8px;
                ProgressIndicator {
                    horizontal-stretch: 1;
                    progress: max(0.0, min(1.0, root.progress));
                }
                Text {
                    width: 44px;
                    text: round(max(0.0, min(1.0, root.progress)) * 100) + "%";
                    color: #d8ded9;
                    font-size: 11px;
                    font-family: "monospace";
                    font-weight: 700;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}
