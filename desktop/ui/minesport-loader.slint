import { ProgressIndicator } from "std-widgets.slint";

// Reusable Minesport loading surface.
//
// Working loop:
//   9 constant-size dots orbit -> collapse -> one large center mass -> the
//   center mass shrinks while ejecting the same 9 normal-size dots -> orbit.
// Completion:
//   dots collapse -> center mass -> an 8x8 monochrome pixel creeper-face mark
//   assembles from the center -> hold -> fade. Callers own placement and may
//   keep their host alive until `finished()` fires.
export component MinesportLoader inherits Rectangle {
    in property <bool> active: false;
    in property <string> title: "Working…";
    in property <string> detail: "";
    in property <float> progress: 0.0;
    in property <bool> determinate: false;
    in property <bool> compact: false;
    // Long-running background jobs can disable the 60-FPS orbit while keeping
    // the same progress surface. Progress/property updates still repaint.
    in property <bool> animate-working: true;
    out property <bool> finishing: false;
    callback finished();

    private property <float> cycle: 0.0;
    private property <bool> was-active: root.active;
    private property <int> finish-step: 0;

    min-width: root.compact ? 240px : 340px;
    preferred-width: root.compact ? 330px : 460px;
    min-height: root.compact ? 76px : 106px;
    preferred-height: root.compact ? 82px : 120px;
    visible: root.active || root.finishing;
    opacity: root.finish-step >= 4 ? 0.0 : 1.0;
    background: #141817f2;
    border-width: 1px;
    border-color: #3b453f;
    border-radius: 9px;

    animate opacity {
        duration: 190ms;
        easing: ease-out;
    }

    changed active => {
        if (root.active) {
            root.was-active = true;
            root.finishing = false;
            root.finish-step = 0;
            root.cycle = 0.0;
            finish-timer.running = false;
        } else if (root.was-active) {
            root.was-active = false;
            root.finishing = true;
            root.finish-step = 1;
            finish-timer.running = true;
        }
    }

    orbit-timer := Timer {
        interval: 16ms;
        running: root.active && root.animate-working;
        triggered() => {
            root.cycle = mod(root.cycle + 0.0054, 1.0);
        }
    }

    finish-timer := Timer {
        interval: 190ms;
        running: false;
        triggered() => {
            if (!root.finishing) {
                self.running = false;
            } else if (root.finish-step < 5) {
                root.finish-step += 1;
            } else {
                root.finishing = false;
                root.finish-step = 0;
                self.running = false;
                root.finished();
            }
        }
    }

    function smooth(t: float) -> float {
        let c = max(0.0, min(1.0, t));
        return c * c * (3.0 - 2.0 * c);
    }

    function spawn-progress(index: int) -> float {
        if (root.finishing || root.cycle >= 0.22) { return 1.0; }
        let start = index * 0.018;
        let finish = start + 0.08;
        return root.smooth((root.cycle - start) / (finish - start));
    }

    function collapse-progress(index: int) -> float {
        if (root.finishing) { return 1.0; }
        if (root.cycle < 0.60) { return 0.0; }
        if (root.cycle >= 0.76) { return 1.0; }
        let start = 0.60 + index * 0.010;
        let finish = start + 0.08;
        return root.smooth((root.cycle - start) / (finish - start));
    }

    function dot-radius(index: int) -> length {
        if (root.finishing) { return 0px; }
        return 21px * (1.0 - root.collapse-progress(index));
    }

    function dot-opacity(index: int) -> float {
        if (root.finishing) { return root.finish-step <= 1 ? 1.0 : 0.0; }
        if (root.cycle >= 0.78) { return 0.0; }
        return root.spawn-progress(index) * (1.0 - root.collapse-progress(index));
    }

    function dot-size(index: int) -> length {
        return 6px * (0.62 + 0.38 * root.spawn-progress(index));
    }

    function center-mass-size() -> length {
        if (root.finishing && root.finish-step == 1) { return 30px; }
        if (!root.active || root.cycle < 0.64 || root.cycle >= 0.83) { return 0px; }
        if (root.cycle < 0.76) {
            return 4px + 16px * root.smooth((root.cycle - 0.64) / 0.12);
        }
        return 20px * (1.0 - root.smooth((root.cycle - 0.76) / 0.07));
    }

    function beam-opacity() -> float {
        if (!root.active || root.cycle < 0.75 || root.cycle >= 0.83) { return 0.0; }
        if (root.cycle < 0.79) { return root.smooth((root.cycle - 0.75) / 0.04); }
        return 1.0 - root.smooth((root.cycle - 0.79) / 0.04);
    }

    function active-face-progress() -> float {
        if (!root.active || root.cycle < 0.82 || root.cycle >= 0.98) { return 0.0; }
        if (root.cycle < 0.87) { return root.smooth((root.cycle - 0.82) / 0.05); }
        if (root.cycle < 0.93) { return 1.0; }
        return 1.0 - root.smooth((root.cycle - 0.93) / 0.05);
    }

    function dot-x(index: int) -> length {
        if (root.finishing) { return 32px; }
        let base = -53.333deg + index * 13.333deg;
        let sweep = root.cycle < 0.22 ? 0.0 : min(1.0, (root.cycle - 0.22) / 0.38);
        let angle = base + sweep * 540deg;
        return 32px + cos(angle) * root.dot-radius(index);
    }

    function dot-y(index: int) -> length {
        if (root.finishing) { return 32px; }
        let base = -53.333deg + index * 13.333deg;
        let sweep = root.cycle < 0.22 ? 0.0 : min(1.0, (root.cycle - 0.22) / 0.38);
        let angle = base + sweep * 540deg;
        return 32px + sin(angle) * root.dot-radius(index);
    }

    function pixel-column(index: int) -> int {
        return mod(index, 8);
    }

    function pixel-row(index: int) -> int {
        return floor(index / 8);
    }

    function face-pixel-black(index: int) -> bool {
        let row = root.pixel-row(index);
        let col = root.pixel-column(index);
        if ((row == 1 || row == 2) && ((col >= 1 && col <= 2) || (col >= 5 && col <= 6))) {
            return true;
        }
        if (row == 3 && (col == 3 || col == 4)) {
            return true;
        }
        if ((row == 4 || row == 5) && col >= 2 && col <= 5) {
            return true;
        }
        if (row == 6 && (col == 2 || col == 5)) {
            return true;
        }
        if (row == 7 && ((col >= 1 && col <= 2) || (col >= 5 && col <= 6))) {
            return true;
        }
        return false;
    }

    function pixel-x(index: int) -> length {
        if (root.finishing) {
            if (root.finish-step <= 1) { return 30px; }
            return 6px + root.pixel-column(index) * 6px;
        }
        let target = 6px + root.pixel-column(index) * 6px;
        return 30px + (target - 30px) * root.active-face-progress();
    }

    function pixel-y(index: int) -> length {
        if (root.finishing) {
            if (root.finish-step <= 1) { return 30px; }
            return 6px + root.pixel-row(index) * 6px;
        }
        let target = 6px + root.pixel-row(index) * 6px;
        return 30px + (target - 30px) * root.active-face-progress();
    }

    HorizontalLayout {
        padding: root.compact ? 10px : 14px;
        spacing: root.compact ? 10px : 14px;
        cross-axis-alignment: center;

        indicator := Rectangle {
            width: 64px;
            height: 64px;
            background: transparent;

            horizontal-beam := Rectangle {
                width: 44px;
                height: 2px;
                x: 10px;
                y: 31px;
                border-radius: 1px;
                background: #f2f4f3;
                opacity: root.beam-opacity();
            }

            vertical-beam := Rectangle {
                width: 2px;
                height: 44px;
                x: 31px;
                y: 10px;
                border-radius: 1px;
                background: #f2f4f3;
                opacity: root.beam-opacity() * 0.72;
            }

            center-mass := Rectangle {
                width: root.center-mass-size();
                height: self.width;
                x: 32px - self.width / 2;
                y: 32px - self.height / 2;
                border-radius: self.width / 2;
                background: #f2f4f3;
                visible: self.width > 0px;
            }

            for dot[index] in 9: Rectangle {
                width: root.dot-size(index);
                height: self.width;
                x: root.dot-x(index) - self.width / 2;
                y: root.dot-y(index) - self.height / 2;
                border-radius: self.width / 2;
                background: #f2f4f3;
                opacity: root.dot-opacity(index);
                visible: self.opacity > 0.001;

                animate x, y {
                    duration: 145ms;
                    easing: ease-in-out;
                    enabled: root.finishing;
                }
            }

            for pixel[index] in 64: Rectangle {
                x: root.pixel-x(index);
                y: root.pixel-y(index);
                width: 5px;
                height: 5px;
                border-radius: 0px;
                background: root.face-pixel-black(index) ? #080a09 : #f3f5f4;
                visible: (root.finishing && root.finish-step >= 2 && root.finish-step < 5)
                    || (root.active && root.active-face-progress() > 0.001);
                opacity: root.finishing ? 1.0 : root.active-face-progress();

                animate x, y {
                    duration: 170ms;
                    easing: ease-out;
                    enabled: root.finishing;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: root.compact ? 3px : 6px;
            Text {
                text: root.title;
                color: #eef2ef;
                font-size: root.compact ? 12px : 14px;
                font-weight: 700;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: #aeb8b2;
                font-size: root.compact ? 10px : 11px;
                wrap: word-wrap;
                overflow: elide;
            }
            if root.determinate && root.progress > 0.02: HorizontalLayout {
                spacing: 8px;
                ProgressIndicator {
                    horizontal-stretch: 1;
                    progress: max(0.0, min(1.0, root.progress));
                }
                Text {
                    width: 44px;
                    text: round(max(0.0, min(1.0, root.progress)) * 100) + "%";
                    color: #d8ded9;
                    font-size: 11px;
                    font-family: "monospace";
                    font-weight: 700;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}
