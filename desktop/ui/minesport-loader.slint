import { ProgressIndicator } from "std-widgets.slint";

// Minesport activity animation.
//
// The working state is intentionally time-driven instead of phase-driven:
// every frame advances one continuous clock and each dot derives its own
// position from that clock. Dots move on a true circle, briefly dwell at the
// top, then continue without the whole animation freezing between stages.
//
// Completion is armed by the backend and waits for the orbit to return to the
// top. The dots then spiral into the center and reveal the Creeper mark.
export component MinesportLoader inherits Rectangle {
    in property <bool> active: false;
    in property <bool> complete-requested: false;
    in property <string> title: "Working…";
    in property <string> detail: "";
    in property <float> progress: 0.0;
    in property <bool> determinate: false;
    in property <bool> compact: false;
    in property <bool> animate-working: true;
    out property <bool> finishing: false;
    callback finished();

    private property <float> phase: 0.0;
    private property <float> success: 0.0;
    private property <bool> was-active: root.active;
    private property <bool> completion-armed: false;

    min-width: root.compact ? 250px : 360px;
    preferred-width: root.compact ? 340px : 480px;
    min-height: root.compact ? 84px : 118px;
    preferred-height: root.compact ? 92px : 132px;
    visible: root.active || root.finishing;
    background: #141817f2;
    border-width: 1px;
    border-color: #3b453f;
    border-radius: 9px;

    changed active => {
        if (root.active && !root.was-active) {
            root.was-active = true;
            root.finishing = false;
            root.completion-armed = false;
            root.success = 0.0;
            root.phase = 0.0;
        } else if (!root.active && root.was-active && !root.finishing) {
            root.was-active = false;
            root.completion-armed = false;
        }
    }

    changed complete-requested => {
        if (root.complete-requested && root.active) {
            root.completion-armed = true;
        }
    }

    frame-timer := Timer {
        interval: 16ms;
        running: root.active && root.animate-working && !root.finishing;
        triggered() => {
            // Finish only when the train comes back through the top. This keeps
            // completion from snapping the dots out of a random orbit position.
            if (root.completion-armed && (root.phase <= 0.035 || root.phase >= 0.965)) {
                root.finishing = true;
                root.success = 0.0;
                return;
            }
            root.phase = mod(root.phase + 0.0048, 1.0);
        }
    }

    success-timer := Timer {
        interval: 16ms;
        running: root.finishing;
        triggered() => {
            // Keep angular motion alive while the ring collapses so completion
            // is one continuous movement rather than another static phase.
            root.phase = mod(root.phase + 0.0060, 1.0);
            root.success = min(1.0, root.success + 0.018);
            if (root.success >= 1.0) {
                self.running = false;
                root.finishing = false;
                root.completion-armed = false;
                root.finished();
            }
        }
    }

    function clamp01(t: float) -> float {
        return max(0.0, min(1.0, t));
    }

    function smooth(t: float) -> float {
        let c = root.clamp01(t);
        return c * c * (3.0 - 2.0 * c);
    }

    function raw-dot-progress(index: int) -> float {
        // Keep a compact train. Every dot runs from the same clock, so changing
        // task text/progress can never restart or step the animation.
        return mod(root.phase - index * 0.055 + 20.0, 1.0);
    }

    function orbit-progress(index: int) -> float {
        let p = root.raw-dot-progress(index);
        // The first/last 8% of a lap are the same physical point (12 o'clock).
        // Holding those ranges creates the familiar top pause while other dots
        // continue moving, so the animation itself never globally freezes.
        if (p <= 0.08) { return 0.0; }
        if (p >= 0.92) { return 1.0; }
        return (p - 0.08) / 0.84;
    }

    function dot-angle(index: int) -> angle {
        return -90deg + root.orbit-progress(index) * 360deg;
    }

    function finish-radius() -> length {
        if (!root.finishing) { return 31px; }
        return 31px * (1.0 - root.smooth(root.success / 0.48));
    }

    function dot-x(index: int) -> length {
        let angle = root.dot-angle(index);
        return 46px + cos(angle) * root.finish-radius();
    }

    function dot-y(index: int) -> length {
        let angle = root.dot-angle(index);
        return 46px + sin(angle) * root.finish-radius();
    }

    function dot-opacity(index: int) -> float {
        if (!root.finishing) { return 1.0; }
        return 1.0 - root.smooth((root.success - 0.14) / 0.34);
    }

    function core-size() -> length {
        if (!root.finishing) { return 0px; }
        let t = root.success;
        if (t < 0.48) {
            return root.smooth(t / 0.48) * 34px;
        }
        if (t < 0.70) {
            return 34px + root.smooth((t - 0.48) / 0.22) * 20px;
        }
        return 54px - root.smooth((t - 0.70) / 0.22) * 10px;
    }

    function core-radius() -> length {
        if (!root.finishing) { return 0px; }
        let square = root.smooth((root.success - 0.55) / 0.24);
        return root.core-size() / 2 * (1.0 - square) + 5px * square;
    }

    function face-opacity() -> float {
        if (!root.finishing) { return 0.0; }
        return root.smooth((root.success - 0.64) / 0.18);
    }

    HorizontalLayout {
        padding: root.compact ? 10px : 14px;
        spacing: root.compact ? 10px : 16px;
        cross-axis-alignment: center;

        indicator := Rectangle {
            width: 92px;
            height: 92px;
            background: transparent;

            core := Rectangle {
                width: root.core-size();
                height: self.width;
                x: 46px - self.width / 2;
                y: 46px - self.height / 2;
                border-radius: root.core-radius();
                background: #f2f4f3;
                visible: self.width > 0.8px;

                Rectangle {
                    x: core.width * 0.18;
                    y: core.height * 0.22;
                    width: core.width * 0.22;
                    height: core.height * 0.22;
                    background: #080a09;
                    opacity: root.face-opacity();
                }
                Rectangle {
                    x: core.width * 0.60;
                    y: core.height * 0.22;
                    width: core.width * 0.22;
                    height: core.height * 0.22;
                    background: #080a09;
                    opacity: root.face-opacity();
                }
                Rectangle {
                    x: core.width * 0.39;
                    y: core.height * 0.43;
                    width: core.width * 0.22;
                    height: core.height * 0.18;
                    background: #080a09;
                    opacity: root.face-opacity();
                }
                Rectangle {
                    x: core.width * 0.28;
                    y: core.height * 0.56;
                    width: core.width * 0.44;
                    height: core.height * 0.20;
                    background: #080a09;
                    opacity: root.face-opacity();
                }
                Rectangle {
                    x: core.width * 0.28;
                    y: core.height * 0.70;
                    width: core.width * 0.15;
                    height: core.height * 0.16;
                    background: #080a09;
                    opacity: root.face-opacity();
                }
                Rectangle {
                    x: core.width * 0.57;
                    y: core.height * 0.70;
                    width: core.width * 0.15;
                    height: core.height * 0.16;
                    background: #080a09;
                    opacity: root.face-opacity();
                }
            }

            for dot[index] in 9: Rectangle {
                width: 6px;
                height: 6px;
                x: root.dot-x(index) - self.width / 2;
                y: root.dot-y(index) - self.height / 2;
                border-radius: 3px;
                background: #f2f4f3;
                opacity: root.dot-opacity(index);
                visible: self.opacity > 0.001;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: root.compact ? 3px : 6px;
            Text {
                text: root.title;
                color: #eef2ef;
                font-size: root.compact ? 12px : 14px;
                font-weight: 700;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: #aeb8b2;
                font-size: root.compact ? 10px : 11px;
                wrap: word-wrap;
                overflow: elide;
            }
            if root.determinate && root.progress > 0.02: HorizontalLayout {
                spacing: 8px;
                ProgressIndicator {
                    horizontal-stretch: 1;
                    progress: max(0.0, min(1.0, root.progress));
                }
                Text {
                    width: 44px;
                    text: round(max(0.0, min(1.0, root.progress)) * 100) + "%";
                    color: #d8ded9;
                    font-size: 11px;
                    font-family: "monospace";
                    font-weight: 700;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}
