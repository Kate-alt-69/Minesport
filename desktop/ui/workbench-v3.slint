import { Button, CheckBox, ComboBox, LineEdit, ProgressIndicator, ScrollView, SpinBox } from "std-widgets.slint";
import { AssetEditor } from "asset-editor.slint";
import { MinesportLoader } from "minesport-loader.slint";

// Labeled standard buttons keep navigation discoverable, keyboard-focusable,
// and exposed to accessibility APIs without custom mouse-only hit targets.
component RailButton inherits Button {
    in property <string> tip;
    in property <bool> active;
    width: 88px;
    height: 44px;
    text: root.tip;
    checkable: true;
    checked: root.active;
}

component SectionTitle inherits Text {
    in property <string> label;
    text: label;
    height: 24px;
    color: #a7b0aa;
    font-size: 12px;
    font-weight: 700;
    vertical-alignment: center;
}

component HintText inherits Text {
    color: #b3bdb7;
    font-size: 13px;
    wrap: word-wrap;
}

component Surface inherits Rectangle {
    background: #171a1a;
    border-width: 1px;
    border-color: #2d3230;
    border-radius: 5px;
}

component WorldMapView inherits Rectangle {
    in property <image> source;
    in property <bool> available;
    in property <bool> pan-mode: false;
    in-out property <int> map-min-x;
    in-out property <int> map-min-z;
    in-out property <int> map-max-x;
    in-out property <int> map-max-z;
    in-out property <int> selection-mode;
    in-out property <int> min-x;
    in-out property <int> max-x;
    in-out property <int> min-z;
    in-out property <int> max-z;
    in-out property <int> center-x;
    in-out property <int> center-z;
    in-out property <int> radius-x;
    in-out property <int> radius-z;
    in-out property <string> cursor-label;

    private property <float> zoom: 1.0;
    private property <length> offset-x: 0px;
    private property <length> offset-y: 0px;
    private property <bool> panning: false;
    private property <bool> pan-with-left: false;
    private property <bool> dragging: false;
    private property <length> pan-start-x: 0px;
    private property <length> pan-start-y: 0px;
    private property <length> pan-offset-x: 0px;
    private property <length> pan-offset-y: 0px;
    private property <length> pan-latest-x: 0px;
    private property <length> pan-latest-y: 0px;
    private property <bool> pan-dirty: false;
    private property <float> pending-zoom-factor: 1.0;
    private property <length> zoom-anchor-x: 0px;
    private property <length> zoom-anchor-y: 0px;
    private property <bool> zoom-dirty: false;
    private property <int> drag-start-x: 0;
    private property <int> drag-start-z: 0;
    private property <int> hover-x: 0;
    private property <int> hover-z: 0;

    background: #0f1216;
    clip: true;

    function image-width() -> length {
        return max(1px, root.source.width * 1px * root.zoom);
    }
    function image-height() -> length {
        return max(1px, root.source.height * 1px * root.zoom);
    }
    function world-x(sx: length) -> int {
        if (root.source.width <= 0 || root.map-max-x <= root.map-min-x) { return root.map-min-x; }
        let span = root.map-max-x - root.map-min-x;
        return max(root.map-min-x, min(root.map-max-x - 1,
            floor(root.map-min-x + ((sx - root.offset-x) / root.image-width()) * span)));
    }
    function world-z(sy: length) -> int {
        if (root.source.height <= 0 || root.map-max-z <= root.map-min-z) { return root.map-min-z; }
        let span = root.map-max-z - root.map-min-z;
        return max(root.map-min-z, min(root.map-max-z - 1,
            floor(root.map-min-z + ((sy - root.offset-y) / root.image-height()) * span)));
    }
    function screen-x(wx: int) -> length {
        if (root.map-max-x <= root.map-min-x) { return root.offset-x; }
        return root.offset-x + (((wx - root.map-min-x) * 1.0) / (root.map-max-x - root.map-min-x)) * root.image-width();
    }
    function screen-z(wz: int) -> length {
        if (root.map-max-z <= root.map-min-z) { return root.offset-y; }
        return root.offset-y + (((wz - root.map-min-z) * 1.0) / (root.map-max-z - root.map-min-z)) * root.image-height();
    }
    function clamp-view() {
        if (!root.available || root.source.width <= 0 || root.source.height <= 0) { return; }
        let w = root.image-width();
        let h = root.image-height();
        let pad-x = max(32px, root.width * 0.1);
        let pad-y = max(32px, root.height * 0.1);
        if (w + pad-x * 2 <= root.width) {
            root.offset-x = (root.width - w) / 2;
        } else {
            root.offset-x = min(pad-x, max(root.width - w - pad-x, root.offset-x));
        }
        if (h + pad-y * 2 <= root.height) {
            root.offset-y = (root.height - h) / 2;
        } else {
            root.offset-y = min(pad-y, max(root.height - h - pad-y, root.offset-y));
        }
    }
    function apply-pan-frame() {
        if (!root.panning || !root.pan-dirty) { return; }
        root.offset-x = root.pan-offset-x + root.pan-latest-x - root.pan-start-x;
        root.offset-y = root.pan-offset-y + root.pan-latest-y - root.pan-start-y;
        root.pan-dirty = false;
        root.clamp-view();
    }
    function apply-zoom-frame() {
        if (!root.zoom-dirty || root.zoom <= 0) { return; }
        let old = root.zoom;
        let next = max(0.05, min(64.0, old * root.pending-zoom-factor));
        let factor = next / old;
        root.offset-x = root.zoom-anchor-x - (root.zoom-anchor-x - root.offset-x) * factor;
        root.offset-y = root.zoom-anchor-y - (root.zoom-anchor-y - root.offset-y) * factor;
        root.zoom = next;
        root.pending-zoom-factor = 1.0;
        root.zoom-dirty = false;
        root.clamp-view();
    }
    public function fit() {
        if (!root.available || root.source.width <= 0 || root.source.height <= 0 || root.width <= 0px || root.height <= 0px) { return; }
        root.pan-dirty = false;
        root.zoom-dirty = false;
        root.pending-zoom-factor = 1.0;
        let zx = root.width / (root.source.width * 1px);
        let zy = root.height / (root.source.height * 1px);
        root.zoom = max(0.05, min(64.0, min(zx, zy) * 0.94));
        root.offset-x = (root.width - root.image-width()) / 2;
        root.offset-y = (root.height - root.image-height()) / 2;
        root.clamp-view();
    }

    changed source => { root.fit(); }
    changed available => {
        if (root.available) { root.fit(); }
        else { root.panning = false; root.dragging = false; root.pan-dirty = false; }
    }

    pan-frame := Timer {
        interval: 16ms;
        running: root.panning;
        triggered() => { root.apply-pan-frame(); }
    }

    zoom-frame := Timer {
        interval: 16ms;
        running: root.zoom-dirty;
        triggered() => { root.apply-zoom-frame(); }
    }

    if root.available: Image {
        x: root.offset-x;
        y: root.offset-y;
        width: root.image-width();
        height: root.image-height();
        source: root.source;
        image-fit: fill;
        image-rendering: pixelated;
    }

    map-touch := TouchArea {
        enabled: root.available;
        mouse-cursor: root.panning ? grabbing : root.pan-mode ? grab : crosshair;
        pointer-event(event) => {
            if ((event.button == PointerEventButton.middle || (root.pan-mode && event.button == PointerEventButton.left)) && event.kind == PointerEventKind.down) {
                root.panning = true;
                root.pan-with-left = event.button == PointerEventButton.left;
                root.pan-start-x = self.mouse-x;
                root.pan-start-y = self.mouse-y;
                root.pan-latest-x = self.mouse-x;
                root.pan-latest-y = self.mouse-y;
                root.pan-offset-x = root.offset-x;
                root.pan-offset-y = root.offset-y;
                root.pan-dirty = false;
                return;
            }

            if (root.panning) {
                if (event.kind == PointerEventKind.move) {
                    root.pan-latest-x = self.mouse-x;
                    root.pan-latest-y = self.mouse-y;
                    root.pan-dirty = true;
                    return;
                }
                if (event.kind == PointerEventKind.cancel || (event.kind == PointerEventKind.up && (root.pan-with-left ? event.button == PointerEventButton.left : event.button == PointerEventButton.middle))) {
                    root.pan-latest-x = self.mouse-x;
                    root.pan-latest-y = self.mouse-y;
                    root.pan-dirty = true;
                    root.apply-pan-frame();
                    root.panning = false;
                    return;
                }
                return;
            }

            let wx = root.world-x(self.mouse-x);
            let wz = root.world-z(self.mouse-y);
            root.hover-x = wx;
            root.hover-z = wz;
            root.cursor-label = "X " + wx + "  ·  Z " + wz;

            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.selection-mode == 1) {
                root.center-x = wx;
                root.center-z = wz;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.dragging = true;
                root.drag-start-x = wx;
                root.drag-start-z = wz;
                if (root.selection-mode == 0) {
                    root.min-x = wx; root.max-x = wx;
                    root.min-z = wz; root.max-z = wz;
                }
            }
            if (event.kind == PointerEventKind.move && root.dragging && root.selection-mode == 0) {
                root.min-x = min(root.drag-start-x, wx);
                root.max-x = max(root.drag-start-x, wx);
                root.min-z = min(root.drag-start-z, wz);
                root.max-z = max(root.drag-start-z, wz);
            }
            if (event.button == PointerEventButton.left && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel)) {
                if (root.selection-mode == 1) {
                    root.center-x = wx;
                    root.center-z = wz;
                } else {
                    root.min-x = min(root.drag-start-x, wx);
                    root.max-x = max(root.drag-start-x, wx);
                    root.min-z = min(root.drag-start-z, wz);
                    root.max-z = max(root.drag-start-z, wz);
                }
                root.dragging = false;
            }
        }
        scroll-event(event) => {
            if (!root.available || root.zoom <= 0 || event.delta-y == 0px) { return reject; }
            root.zoom-anchor-x = self.mouse-x;
            root.zoom-anchor-y = self.mouse-y;
            root.pending-zoom-factor *= event.delta-y > 0px ? 1.12 : (1.0 / 1.12);
            root.zoom-dirty = true;
            return accept;
        }
    }

    if root.available && map-touch.has-hover && !root.panning: Rectangle {
        x: root.screen-x(root.hover-x);
        y: root.screen-z(root.hover-z);
        width: max(1px, root.screen-x(root.hover-x + 1) - root.screen-x(root.hover-x));
        height: max(1px, root.screen-z(root.hover-z + 1) - root.screen-z(root.hover-z));
        background: #ffffff08;
        border-width: 1px;
        border-color: #ffffffbe;
    }

    if root.available && root.selection-mode == 0: Rectangle {
        x: root.screen-x(min(root.min-x, root.max-x));
        y: root.screen-z(min(root.min-z, root.max-z));
        width: max(1px, root.screen-x(max(root.min-x, root.max-x) + 1) - self.x);
        height: max(1px, root.screen-z(max(root.min-z, root.max-z) + 1) - self.y);
        background: #5aff8c2d;
        border-width: 2px;
        border-color: #5aff8ce6;
    }

    if root.available && root.selection-mode == 1: Rectangle {
        x: root.screen-x(root.center-x - root.radius-x);
        y: root.screen-z(root.center-z - root.radius-z);
        width: max(1px, root.screen-x(root.center-x + root.radius-x + 1) - self.x);
        height: max(1px, root.screen-z(root.center-z + root.radius-z + 1) - self.y);
        background: #50beff23;
        border-width: 2px;
        border-color: #50beffdc;
    }
}

export component MainWindow inherits Window {
    title: "Minesport — by Kastrick";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 640px;
    background: #0d0f10;
    forward-focus: app-focus;

    in-out property <int> active-activity: 0;
    in-out property <int> settings-page: 0;
    in-out property <int> viewport-mode: 0;
    in-out property <bool> settings-visible: false;
    in-out property <bool> debug-console-visible: false;
    private property <bool> coordinates-visible: false;
    private property <bool> export-details-visible: false;
    private property <bool> advanced-settings-visible: false;
    private property <bool> controls-visible: false;
    private property <bool> map-pan-mode: false;
    private property <bool> world-selected: root.world-path != "No world selected";
    private property <bool> can-export: root.engine-ready && !root.foreground-busy && root.world-selected;
    // Floating point multiplication avoids overflow for large world bounds.
    private property <float> selection-volume: root.selection-mode == 0
        ? (abs(root.max-x - root.min-x) + 1.0) * (abs(root.max-y - root.min-y) + 1.0) * (abs(root.max-z - root.min-z) + 1.0)
        : (root.radius-x * 2.0 + 1.0) * (root.radius-y * 2.0 + 1.0) * (root.radius-z * 2.0 + 1.0);

    in-out property <string> world-path: "No world selected";
    in-out property <string> world-name: "No world selected";
    in-out property <string> minecraft-version: "—";
    in-out property <string> loader-type: "—";
    in-out property <int> selection-mode: 0;
    in-out property <int> min-x: -256;
    in-out property <int> min-y: -64;
    in-out property <int> min-z: -256;
    in-out property <int> max-x: 256;
    in-out property <int> max-y: 320;
    in-out property <int> max-z: 256;
    in-out property <int> center-x: 0;
    in-out property <int> center-y: 64;
    in-out property <int> center-z: 0;
    in-out property <int> radius-x: 32;
    in-out property <int> radius-y: 32;
    in-out property <int> radius-z: 32;

    in-out property <image> map-image;
    in-out property <bool> map-available: false;
    in-out property <bool> map-loading: false;
    in-out property <int> map-min-x: -256;
    in-out property <int> map-min-z: -256;
    in-out property <int> map-max-x: 256;
    in-out property <int> map-max-z: 256;
    in-out property <int> map-scale: 1;
    in-out property <string> map-cursor-label: "X —  ·  Z —";

    in-out property <image> preview-image;
    in-out property <bool> preview-available: false;
    in-out property <bool> preview-loading: false;
    in-out property <int> preview-block-count: 0;
    in-out property <string> preview-focus-label: "LMB point A · RMB point B · LMB again confirms";
    in-out property <int> preview-pick-button: 0;
    private property <bool> preview-resize-held: false;

    in-out property <string> output-path: "";
    in-out property <string> export-name: "Minesport_Export";
    in-out property <int> export-format-index: 0;
    in-out property <int> export-mode-index: 0;
    in-out property <bool> optimize: true;
    in-out property <string> preflight-summary: "Preflight has not been run for this selection.";

    in-out property <bool> face-culling: true;
    in-out property <bool> flatter-enabled: true;
    in-out property <int> flatter-cell-index: 3;
    in-out property <bool> hidden-culling: false;
    in-out property <bool> blender-export: true;
    in-out property <bool> select-by-model: false;
    in-out property <bool> debug-mode: false;
    in-out property <int> blender-animation-index: 0;
    in-out property <bool> blender-translator-prompted: false;
    in-out property <string> blender-translator-status: "Blender translator 0.1.8: checking…";
    in-out property <bool> blender-translator-current: false;
    in-out property <bool> blender-prompt-visible: false;
    in-out property <string> blender-prompt-message: "";
    in-out property <string> resource-pack-summary: "No resource-pack overrides";
    in-out property <string> data-pack-summary: "No data-pack overrides";
    in property <[string]> resource-pack-items;
    in property <[string]> data-pack-items;
    in-out property <int> resource-pack-selected: 0;
    in-out property <int> data-pack-selected: 0;

    in-out property <string> engine-status: "STARTING";
    in-out property <bool> engine-ready: false;
    in-out property <string> runtime-cache-status: "WAITING FOR WORLD";
    in-out property <bool> runtime-cache-busy: false;
    in-out property <string> task-title: "IDLE";
    in-out property <string> task-detail: "Ready";
    in-out property <float> task-progress: 0.0;
    in-out property <bool> task-active: false;
    private property <bool> foreground-busy: root.task-active || root.runtime-cache-busy;
    private property <bool> task-failed: root.task-title == "ENGINE ERROR" || root.task-title == "INVALID WORLD"
        || root.task-title == "MAP FAILED" || root.task-title == "EXPORT FAILED" || root.task-title == "EXPORT BLOCKED"
        || root.task-title == "PREFLIGHT FAILED" || root.task-title == "3D PREVIEW FAILED"
        || root.task-title == "RUNTIME CACHE FAILED" || root.task-title == "ENGINE OPERATION FAILED"
        || root.task-title == "BLENDER INSTALL FAILED" || root.task-title == "CACHE CLEANUP FAILED";
    in-out property <bool> task-completing: false;
    in-out property <string> task-completion-detail: "";
    in-out property <string> diagnostics: "Minesport Rust/Slint desktop initialized.";

    in-out property <bool> docs-visible: false;
    in-out property <int> doc-page: 1;
    in-out property <int> doc-total: 8;
    in-out property <string> doc-title: "Start Here";
    in-out property <string> doc-content: "Open Documentation from Settings to load the Minesport manual.";
    in-out property <bool> doc-video-available: false;

    callback pick-world();
    callback pick-output();
    callback reload-map();
    callback export-requested();
    callback run-preflight();
    callback open-3d();
    callback preview-click(float, float, float, float);
    callback preview-orbit(float, float);
    callback preview-pan(float, float);
    callback preview-dolly(float);
    callback preview-fit();
    callback preview-clear();
    callback preview-resize(int);
    callback rebuild-runtime-cache();
    callback cancel-runtime-cache();
    callback remove-cache();
    callback add-resource-pack();
    callback add-resource-pack-folder();
    callback move-resource-pack(int);
    callback remove-resource-pack();
    callback add-data-pack();
    callback move-data-pack(int);
    callback remove-data-pack();
    callback install-blender-translator();
    callback blender-prompt-install();
    callback blender-prompt-later();
    callback open-docs();
    callback docs-navigate(int);
    callback docs-open-github();
    callback docs-open-video();
    callback settings-changed();

    private property <int> export-preset-index: 0;

    app-focus := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.blender-prompt-visible) { root.blender-prompt-later(); return accept; }
                if (root.settings-visible) { root.settings-visible = false; return accept; }
                if (root.docs-visible) { root.docs-visible = false; return accept; }
                if (root.controls-visible) { root.controls-visible = false; return accept; }
            }
            if (root.blender-prompt-visible || root.settings-visible) {
                return reject;
            }
            // Do not consume C/E/F while a text field or coordinate editor owns focus.
            if (app-focus.has-focus && root.viewport-mode == 1 && root.preview-available && !root.preview-loading) {
                if (event.text == "c" || event.text == "C") {
                    root.preview-clear();
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.preview-resize-held = true;
                    return accept;
                }
                if (event.text == "f" || event.text == "F") {
                    root.preview-fit();
                    return accept;
                }
            }
            if (event.text == Key.F6) {
                if (root.viewport-mode == 0 && root.map-available) {
                    map-view.fit();
                    return accept;
                }
                if (root.viewport-mode == 1 && root.preview-available && !root.preview-loading) {
                    root.preview-fit();
                    return accept;
                }
            }
            return reject;
        }
        capture-key-released(event) => {
            if (event.text == "e" || event.text == "E") {
                root.preview-resize-held = false;
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle { height: 3px; background: #4e8a3a; }
            Rectangle {
                height: 52px;
                background: #1e1f1d;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Text { text: "MINESPORT"; color: #f2f4f1; font-size: 17px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { width: 1px; height: 26px; background: #444946; }
                    if root.width >= 1100px: Text { text: "Your world. Ready for your next creation."; color: #b3bdb7; font-size: 13px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: !root.world-selected ? "Minecraft → Blender & beyond" : root.world-name + "  ·  " + root.minecraft-version + "  ·  " + root.loader-type;
                        color: #b9c1bc;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 540px;
                    }
                    Button { text: "Help"; clicked => { root.open-docs(); } }
                }
            }

            Rectangle {
                height: 58px;
                background: #111a17;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Button { text: "1 · Open world"; enabled: !root.foreground-busy; clicked => { root.active-activity = 0; root.pick-world(); } }
                    Text { text: "→"; color: #91b491; }
                    Button { text: "2 · Select area"; checkable: true; checked: root.active-activity == 0 && root.world-selected; enabled: root.world-selected; clicked => { root.active-activity = 0; } }
                    Text { text: "→"; color: #91b491; }
                    Button { text: "3 · Export"; checkable: true; checked: root.active-activity == 1; enabled: root.world-selected; clicked => { root.active-activity = 1; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if root.width >= 1100px: Text { text: "Original world stays untouched"; color: #b3bdb7; font-size: 12px; }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                Rectangle {
                    width: 104px;
                    background: #0e1010;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Rectangle {
                            height: 44px;
                            background: transparent;
                            Text { text: "M"; color: #dce2dd; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        RailButton { tip: "World"; active: root.active-activity == 0; clicked => { root.active-activity = 0; } }
                        RailButton { tip: "Export"; active: root.active-activity == 1; clicked => { root.active-activity = 1; } }
                        RailButton { tip: "Blender"; active: root.active-activity == 2; clicked => { root.active-activity = 2; } }
                        RailButton { tip: "Activity"; active: root.active-activity == 3; clicked => { root.active-activity = 3; } }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        RailButton { tip: "Settings"; active: root.settings-visible; clicked => { root.settings-visible = true; } }
                    }
                }

                Rectangle {
                    min-width: 300px;
                    preferred-width: 330px;
                    max-width: 360px;
                    background: #161818;
                    border-width: 1px;
                    border-color: #2b2f2d;
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 44px;
                            background: #181b1a;
                            border-width: 1px;
                            border-color: #2d3230;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 8px;
                                Text {
                                    text: root.active-activity == 0 ? "World & selection" : root.active-activity == 1 ? "Export setup" : root.active-activity == 2 ? "Blender" : "Activity";
                                    color: #e3e7e4;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Button { text: "Help"; clicked => { root.open-docs(); } }
                            }
                        }

                        if root.active-activity == 0: ScrollView {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: root.world-name; color: #eef0ee; font-size: 16px; font-weight: 700; overflow: elide; }
                                if root.world-selected: Text { text: root.world-path; color: #aab2ad; font-size: 12px; wrap: word-wrap; }
                                if root.world-selected: Text { text: root.minecraft-version + "  ·  " + root.loader-type; color: #91b491; font-size: 12px; }
                                Button { text: root.world-selected ? "Change world…" : "Open Minecraft world…"; primary: !root.world-selected; enabled: !root.foreground-busy; clicked => { root.pick-world(); } }
                                if !root.world-selected: HintText { text: "Choose a saved world from your launcher, or browse to a world folder. Then select just the area you need."; }
                                if root.world-selected: VerticalLayout {
                                spacing: 10px;
                                SectionTitle { label: "SELECTION"; }
                                ComboBox { model: ["Box selection", "Bubble selection"]; current-index <=> root.selection-mode; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Select area"; checkable: true; checked: !root.map-pan-mode; clicked => { root.map-pan-mode = false; } }
                                    Button { text: "Pan map"; checkable: true; checked: root.map-pan-mode; clicked => { root.map-pan-mode = true; } }
                                }
                                HintText { text: root.map-pan-mode ? "Drag with the left mouse button to move the map. Switch to Select area when you're ready." : root.selection-mode == 0 ? "Drag on the 2D map to select an area. Use 3D preview to inspect it." : "Click the map to place the bubble. Enter coordinates to adjust its height and radius."; }
                                Text { text: root.selection-mode == 0 ? "Size: " + (abs(root.max-x - root.min-x) + 1) + " × " + (abs(root.max-y - root.min-y) + 1) + " × " + (abs(root.max-z - root.min-z) + 1) + " blocks" : "Radius: " + root.radius-x + " × " + root.radius-y + " × " + root.radius-z + " blocks"; color: #e3e7e4; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                                if root.selection-volume > 16000000: HintText { color: #efcc8a; text: "Large selection. Start with a smaller area for a quicker export, especially on older computers."; }
                                CheckBox { text: "Enter coordinates"; checked <=> root.coordinates-visible; }
                                if root.coordinates-visible && root.selection-mode == 0: VerticalLayout {
                                    spacing: 7px;
                                    HorizontalLayout { spacing: 6px; Text { width: 30px; text: "X"; color: #aab2ad; font-size: 12px; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.min-x; } Text { text: "→"; color: #858d88; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.max-x; } }
                                    HorizontalLayout { spacing: 6px; Text { width: 30px; text: "Y"; color: #aab2ad; font-size: 12px; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -2048; maximum: 4096; value <=> root.min-y; } Text { text: "→"; color: #858d88; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -2048; maximum: 4096; value <=> root.max-y; } }
                                    HorizontalLayout { spacing: 6px; Text { width: 30px; text: "Z"; color: #aab2ad; font-size: 12px; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.min-z; } Text { text: "→"; color: #858d88; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.max-z; } }
                                }
                                if root.coordinates-visible && root.selection-mode == 1: VerticalLayout {
                                    spacing: 7px;
                                    HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Center X"; color: #aab2ad; font-size: 12px; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.center-x; } }
                                    HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Center Y"; color: #aab2ad; font-size: 12px; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -2048; maximum: 4096; value <=> root.center-y; } }
                                    HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Center Z"; color: #aab2ad; font-size: 12px; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.center-z; } }
                                    Rectangle { height: 1px; background: #303532; }
                                    HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Radius X"; color: #aab2ad; font-size: 12px; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: 1; maximum: 30000000; value <=> root.radius-x; } }
                                    HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Radius Y"; color: #aab2ad; font-size: 12px; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: 1; maximum: 4096; value <=> root.radius-y; } }
                                    HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Radius Z"; color: #aab2ad; font-size: 12px; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: 1; maximum: 30000000; value <=> root.radius-z; } }
                                }
                                if root.selection-mode == 0: Button { text: "Use world bounds"; enabled: root.map-available; clicked => { root.min-x = root.map-min-x; root.max-x = root.map-max-x - 1; root.min-z = root.map-min-z; root.max-z = root.map-max-z - 1; } }
                                HintText { text: "Only the selected area is exported. You can adjust it again before exporting."; }
                                Button { text: "Next · Export setup"; primary: true; clicked => { root.active-activity = 1; } }
                                if root.export-format-index < 2: VerticalLayout {
                                    spacing: 8px;
                                    SectionTitle { label: "MODEL PREPARATION"; }
                                    Text { text: root.runtime-cache-status; color: root.runtime-cache-busy ? #dfc27d : #9bb9a0; font-size: 12px; wrap: word-wrap; }
                                    if root.runtime-cache-busy: Button { text: "Cancel preparation"; clicked => { root.cancel-runtime-cache(); } }
                                }
                                }
                            }
                        }

                        if root.active-activity == 1: ScrollView {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                SectionTitle { label: "START WITH A PRESET"; }
                                ComboBox {
                                    model: ["Your current settings", "Blender · Animation", "Blender · Lightweight", "Minecraft · Unoptimized", "Modded · Accuracy"];
                                    current-index <=> root.export-preset-index;
                                    selected(index) => {
                                        if (index == 1) { root.export-format-index = 0; root.export-mode-index = 1; root.optimize = true; root.face-culling = true; root.flatter-enabled = true; root.hidden-culling = false; root.blender-export = true; }
                                        if (index == 2) { root.export-format-index = 0; root.export-mode-index = 0; root.optimize = true; root.face-culling = true; root.flatter-enabled = true; root.hidden-culling = true; root.blender-export = true; }
                                        if (index == 3) { root.export-format-index = 0; root.export-mode-index = 1; root.optimize = false; root.face-culling = false; root.flatter-enabled = false; root.hidden-culling = false; root.blender-export = false; }
                                        if (index == 4) { root.export-format-index = 0; root.export-mode-index = 0; root.optimize = false; root.face-culling = true; root.flatter-enabled = false; root.hidden-culling = false; root.blender-export = true; }
                                        if (index > 0) { root.settings-changed(); }
                                    }
                                }
                                HintText { text: root.export-preset-index == 1 ? "Keeps blocks separate for animation in Blender." : root.export-preset-index == 2 ? "Groups geometry and removes hidden blocks for a smaller Blender scene. Inspect the result: hidden-block culling is experimental." : root.export-preset-index == 3 ? "Keeps individual blocks without mesh optimization or Blender processing." : root.export-preset-index == 4 ? "Uses detailed mod geometry without mesh simplification." : "Use your saved settings, or choose a preset above."; }
                                SectionTitle { label: "EXPORT"; }
                                Text { text: "Name"; color: #aab2ad; font-size: 12px; }
                                LineEdit { text <=> root.export-name; accepted(_) => { root.settings-changed(); } }
                                Text { text: "Export as"; color: #aab2ad; font-size: 12px; }
                                ComboBox { model: ["glTF · Blender & 3D tools", "OBJ · Other 3D tools", "Litematica · Minecraft schematic"]; current-index <=> root.export-format-index; selected(_) => { root.settings-changed(); root.export-preset-index = 0; } }
                                if root.export-format-index < 2: CheckBox { text: "Customize mesh settings"; checked <=> root.export-details-visible; }
                                if root.export-format-index < 2 && root.export-details-visible: VerticalLayout {
                                    spacing: 10px;
                                    Text { text: "Objects"; color: #aab2ad; font-size: 12px; }
                                    ComboBox { model: ["Grouped", "Individual blocks", "Merged"]; current-index <=> root.export-mode-index; selected(_) => { root.settings-changed(); root.export-preset-index = 0; } }
                                    CheckBox { text: "Optimize mesh output"; checked <=> root.optimize; toggled => { root.settings-changed(); root.export-preset-index = 0; } }
                                }
                                SectionTitle { label: "OUTPUT"; }
                                Text { text: root.output-path == "" ? "~/Minesport_Exports" : root.output-path; color: #a7b0aa; font-size: 12px; wrap: word-wrap; }
                                Button { text: "Choose output folder…"; clicked => { root.pick-output(); } }
                                if root.export-format-index < 2 && root.export-details-visible: VerticalLayout {
                                    spacing: 10px;
                                    SectionTitle { label: "OPTIMIZATION"; }
                                    Text { text: "Optimization: face culling " + (root.face-culling ? "ON" : "OFF") + " · FLATTER " + (root.flatter-enabled ? "ON" : "OFF") + " · hidden culling " + (root.hidden-culling ? "ON" : "OFF"); color: #b6beb9; font-size: 12px; wrap: word-wrap; }
                                    Button { text: "Apply safe optimization"; clicked => { root.optimize = true; root.face-culling = true; root.flatter-enabled = true; root.hidden-culling = false; root.export-preset-index = 0; root.settings-changed(); } }
                                }
                                Button { text: root.task-completing ? "Finishing export…" : root.foreground-busy ? "Working…" : "Export selected area"; primary: true; enabled: root.can-export; clicked => { root.export-requested(); } }
                                if !root.can-export: HintText { text: !root.world-selected ? "Open a world first, then select an area to export." : !root.engine-ready ? "Waiting for the export engine. Open Activity if startup needs attention." : root.runtime-cache-busy ? "Preparing model data. Export becomes available when preparation finishes." : "Another task is running. You can continue adjusting your export settings."; }
                                HintText { text: root.export-format-index == 2 ? "Saves block states as a Minecraft schematic. No 3D model preparation is needed." : "Minesport prepares any missing model data automatically. Your original save is never edited."; }
                                if root.task-title == "EXPORT COMPLETE": VerticalLayout {
                                    spacing: 8px;
                                    SectionTitle { label: "EXPORT SAVED"; }
                                    Text { text: root.task-completion-detail; color: #bddbc5; font-size: 13px; wrap: word-wrap; }
                                }
                                if root.task-failed: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Something needs attention"; color: #efcc8a; font-size: 14px; font-weight: 700; }
                                    Text { text: root.task-detail; color: #e3c7ad; font-size: 13px; wrap: word-wrap; }
                                    Button { text: "View details in Activity"; clicked => { root.active-activity = 3; } }
                                }
                            }
                        }

                        if root.active-activity == 2: ScrollView {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                SectionTitle { label: "WORLD INSPECTOR · BLENDER"; }
                                if root.export-format-index == 2: HintText { text: "Litematica is a Minecraft structure export. Blender integration and geometry settings are not used."; }
                                if root.export-format-index < 2 && !root.blender-export: HintText { text: "Blender integration is disabled in Settings."; }
                                if root.export-format-index < 2 && root.blender-export: VerticalLayout {
                                    spacing: 9px;
                                    Text { text: "Animation"; color: #aab2ad; font-size: 12px; }
                                    ComboBox { model: ["Animate export", "Animate static"]; current-index <=> root.blender-animation-index; selected(_) => { root.settings-changed(); } }
                                    HorizontalLayout {
                                        spacing: 7px;
                                        Text { width: 18px; text: root.blender-translator-current ? "✓" : "✕"; color: root.blender-translator-current ? #8fc69b : #d39191; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                        Text { horizontal-stretch: 1; text: root.blender-translator-status; color: #b6beb9; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                    }
                                    Button { text: "Install / repair Minesport translator"; enabled: !root.foreground-busy; clicked => { root.install-blender-translator(); } }
                                    HintText { text: "Animate export prepares dynamic state descriptors plus animated textures. Animate static preserves interactable world state while keeping continuously animated textures."; }
                                    HintText { text: "For OBJ, use Minesport's Blender translator import path. Blender's stock Wavefront importer bypasses Minesport metadata."; }
                                }
                            }
                        }

                        if root.active-activity == 3: ScrollView {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                SectionTitle { label: "TASKS & DIAGNOSTICS"; }
                                HintText { text: "See what Minesport is doing and check details if something goes wrong."; }
                                SectionTitle { label: "ENGINE"; }
                                Text { text: root.engine-status; color: root.engine-ready ? #8fc69b : #d39191; font-size: 13px; font-weight: 700; }
                                SectionTitle { label: "ACTIVE TASK"; }
                                Text { text: root.task-title; color: root.task-failed ? #efcc8a : #e3e7e4; font-size: 14px; font-weight: 700; }
                                Text { text: root.task-detail; color: #b3bdb7; font-size: 13px; wrap: word-wrap; }
                                if root.task-active: ProgressIndicator { progress: root.task-progress; }
                                SectionTitle { label: "RUNTIME REGISTRY"; }
                                Text { text: root.runtime-cache-status; color: #acb5af; font-size: 12px; wrap: word-wrap; }
                                if root.runtime-cache-busy: Button { text: "Cancel runtime worker"; clicked => { root.cancel-runtime-cache(); } }
                                SectionTitle { label: "DIAGNOSTICS"; }
                                Surface {
                                    height: 320px;
                                    ScrollView { Text { x: 10px; y: 10px; width: parent.width - 20px; text: root.diagnostics; color: #bac2bd; font-size: 11px; font-family: "monospace"; wrap: word-wrap; } }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: #0d0f10;
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 46px;
                            background: #141718;
                            border-width: 1px;
                            border-color: #2d3230;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text { text: root.viewport-mode == 0 ? "Drag to select · Scroll to zoom" : "Select two corners to choose an area"; color: #b3bdb7; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Button { text: "Controls"; checkable: true; checked: root.controls-visible; clicked => { root.controls-visible = !root.controls-visible; } }
                                Button { text: "2D map"; checkable: true; checked: root.viewport-mode == 0; clicked => { root.viewport-mode = 0; } }
                                Button { text: "3D preview"; checkable: true; checked: root.viewport-mode == 1; enabled: root.world-selected && !root.foreground-busy; clicked => { root.viewport-mode = 1; root.open-3d(); } }
                                Button {
                                    text: "Fit";
                                    enabled: root.viewport-mode == 0 ? root.map-available : root.preview-available && !root.preview-loading;
                                    clicked => {
                                        if (root.viewport-mode == 0) { map-view.fit(); }
                                        else { root.preview-fit(); }
                                    }
                                }
                            }
                        }

                        viewport-host := Rectangle {
                            vertical-stretch: 1;
                            background: #0f1216;
                            clip: true;

                            map-view := WorldMapView {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                visible: root.viewport-mode == 0;
                                source: root.map-image;
                                available: root.map-available && !root.docs-visible && !root.blender-prompt-visible && !root.settings-visible;
                                pan-mode: root.map-pan-mode;
                                map-min-x <=> root.map-min-x;
                                map-min-z <=> root.map-min-z;
                                map-max-x <=> root.map-max-x;
                                map-max-z <=> root.map-max-z;
                                selection-mode <=> root.selection-mode;
                                min-x <=> root.min-x;
                                max-x <=> root.max-x;
                                min-z <=> root.min-z;
                                max-z <=> root.max-z;
                                center-x <=> root.center-x;
                                center-z <=> root.center-z;
                                radius-x <=> root.radius-x;
                                radius-z <=> root.radius-z;
                                cursor-label <=> root.map-cursor-label;
                            }

                            if root.viewport-mode == 0 && !root.map-available && !root.map-loading: Rectangle {
                                x: 0px; y: 0px; width: parent.width; height: parent.height;
                                background: #0f1715;
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: min(420px, parent.width - 48px);
                                    height: min(300px, parent.height - 24px);
                                    background: #18221e;
                                    border-width: 1px;
                                    border-color: #395044;
                                    border-radius: 12px;
                                    VerticalLayout {
                                        padding: 24px;
                                        spacing: 14px;
                                        Text { text: "WORLD → CREATE"; color: #a4d9b2; font-size: 12px; font-weight: 700; }
                                        Text { text: !root.world-selected ? "Bring your world\nto your next project." : "Let's load your map."; color: #eef4f0; font-size: 24px; font-weight: 700; wrap: word-wrap; }
                                        HintText { text: !root.world-selected ? "Open a Minecraft save, select an area, and export it to Blender, other 3D tools, or Litematica." : "Reload the map to select an area. Check Activity if loading failed."; }
                                        Button {
                                            text: !root.world-selected ? "Open a world…" : "Reload map";
                                            primary: true;
                                            enabled: !root.foreground-busy;
                                            clicked => { if (!root.world-selected) { root.pick-world(); } else { root.reload-map(); } }
                                        }
                                        Text { text: "Your original world stays untouched."; color: #b3bdb7; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                            }

                            if root.viewport-mode == 0 && root.map-loading: Rectangle {
                                x: 0px; y: 0px; width: parent.width; height: parent.height;
                                background: #0f1216;
                            }
                            map-loader := MinesportLoader {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: min(460px, parent.width - 48px);
                                height: 120px;
                                active: root.map-loading;
                                visible: root.viewport-mode == 0 && (root.map-loading || self.finishing);
                                title: root.map-loading ? "Loading chunks…" : "Map ready";
                                detail: root.map-loading ? "Building your map. You can keep adjusting settings while it loads." : "2D map ready";
                                determinate: false;
                                compact: false;
                            }

                            if root.viewport-mode == 1: Rectangle {
                                x: 0px; y: 0px; width: parent.width; height: parent.height;
                                background: #0f1216;
                                if root.preview-available: Image { source: root.preview-image; image-fit: contain; width: parent.width; height: parent.height; }
                                preview-touch := TouchArea {
                                    property <bool> middle-held: false;
                                    property <bool> middle-pan: false;
                                    property <length> middle-start-x: 0px;
                                    property <length> middle-start-y: 0px;

                                    enabled: root.preview-available && !root.preview-loading && !root.docs-visible && !root.blender-prompt-visible && !root.settings-visible;
                                    mouse-cursor: self.middle-held ? grabbing : crosshair;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) { app-focus.focus(); }
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                            root.preview-pick-button = 1;
                                            root.preview-click(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                                        }
                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                            root.preview-pick-button = 2;
                                            root.preview-click(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                                        }
                                        if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.down) {
                                            self.middle-held = true;
                                            self.middle-pan = event.modifiers.shift;
                                            self.middle-start-x = self.mouse-x;
                                            self.middle-start-y = self.mouse-y;
                                        }
                                        if (event.button == PointerEventButton.middle && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && self.middle-held) {
                                            let dx = (self.mouse-x - self.middle-start-x) / 1px;
                                            let dy = (self.mouse-y - self.middle-start-y) / 1px;
                                            let should-apply = event.kind == PointerEventKind.up && (dx != 0 || dy != 0);
                                            if (should-apply) {
                                                if (self.middle-pan) { root.preview-pan(dx, dy); }
                                                else { root.preview-orbit(dx, dy); }
                                            }
                                            self.middle-held = false;
                                            self.middle-pan = false;
                                        }
                                    }
                                    scroll-event(event) => {
                                        if (!root.preview-available || root.preview-loading || event.delta-y == 0px) { return reject; }
                                        if (root.preview-resize-held) {
                                            root.preview-resize(event.delta-y > 0px ? 1 : -1);
                                        } else {
                                            root.preview-dolly(event.delta-y > 0px ? 1.0 : -1.0);
                                        }
                                        return accept;
                                    }
                                }
                                if root.preview-loading: Rectangle {
                                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                                    background: #0f1216;
                                }
                                preview-loader := MinesportLoader {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: min(460px, parent.width - 48px);
                                    height: 120px;
                                    active: root.preview-loading;
                                    visible: root.preview-loading || self.finishing;
                                    title: root.preview-loading ? "Rendering 3D preview…" : "3D preview ready";
                                    detail: root.preview-loading ? "Preparing the selected area. Larger selections take longer." : "Preview ready";
                                    determinate: false;
                                    compact: false;
                                }
                                if !root.preview-available && !root.preview-loading: Rectangle {
                                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                                    Text { x: 0px; y: parent.height / 2 - 56px; width: parent.width; height: 28px; text: "3D PREVIEW"; color: #b8c0bb; font-size: 20px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    Text { x: 0px; y: parent.height / 2 - 20px; width: parent.width; height: 24px; text: "Inspect your selected area before exporting."; color: #b3bdb7; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                    Button { x: (parent.width - 160px) / 2; y: parent.height / 2 + 18px; width: 160px; text: "Generate preview"; enabled: root.world-selected && !root.foreground-busy; clicked => { root.open-3d(); } }
                                }
                                if root.preview-available: Rectangle {
                                    x: 12px; y: 12px; width: 180px; height: 34px; border-radius: 5px; background: #101414e8; border-width: 1px; border-color: #323735;
                                    Text { text: root.preview-block-count + " blocks"; color: #d0d7d2; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                if root.preview-available: Rectangle {
                                    x: 12px; y: parent.height - 46px; width: min(560px, parent.width - 24px); height: 34px; border-radius: 5px; background: #101414e8; border-width: 1px; border-color: #323735;
                                    Text { x: 10px; width: parent.width - 20px; height: parent.height; text: root.preview-focus-label; color: #d0d7d2; font-size: 11px; font-family: "monospace"; vertical-alignment: center; overflow: elide; }
                                }
                            }

                            if root.task-active && root.task-title == "EXPORT": Rectangle {
                                x: 0px; y: 0px; width: parent.width; height: parent.height;
                                background: #0d1012d8;
                            }
                            export-loader := MinesportLoader {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: min(500px, parent.width - 64px);
                                height: 120px;
                                active: root.task-active && root.task-title == "EXPORT";
                                complete-requested: root.task-completing;
                                visible: (root.task-active && root.task-title == "EXPORT") || self.finishing;
                                title: root.task-completing ? "Finishing export…" : "Exporting world…";
                                detail: root.task-detail;
                                progress: root.task-progress;
                                determinate: root.task-progress > 0.02;
                                compact: false;
                                finished => {
                                    if (root.task-completing) {
                                        root.task-completing = false;
                                        root.task-active = false;
                                        root.task-progress = 1.0;
                                        root.task-title = "EXPORT COMPLETE";
                                        root.task-detail = root.task-completion-detail;
                                    }
                                }
                            }

                            if root.controls-visible && !root.docs-visible: Surface {
                                x: parent.width - self.width - 12px;
                                y: 12px;
                                width: min(380px, parent.width - 24px);
                                height: root.viewport-mode == 0 ? 204px : 288px;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        Text { text: root.viewport-mode == 0 ? "Map controls" : "3D controls"; color: #eef4f0; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Button { text: "Close"; clicked => { root.controls-visible = false; } }
                                    }
                                    HintText { text: root.viewport-mode == 0 ? "Left mouse · Select an area, or drag in Pan map mode\nMiddle mouse · Drag to pan anytime\nScroll · Zoom\nF6 · Fit the map" : "Left click · First corner; click again to confirm\nRight click · Second corner\nMiddle mouse · Drag to look around\nShift + middle mouse · Pan\nScroll · Move closer or farther\nE + scroll · Resize selection\nC · Clear selection\nF / F6 · Fit the preview"; }
                                    Text { text: "Esc closes this guide."; color: #b3bdb7; font-size: 12px; }
                                }
                            }

                            if root.docs-visible: Rectangle {
                                x: 0px; y: 0px; width: parent.width; height: parent.height;
                                background: #111413f8;
                                border-width: 1px;
                                border-color: #343a36;
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        height: 50px; background: #191c1a;
                                        HorizontalLayout {
                                            padding-left: 14px; padding-right: 10px;
                                            Text { text: "DOCUMENTATION  ·  Page " + root.doc-page + " of " + root.doc-total + "  ·  " + root.doc-title; color: #eef0ee; font-size: 13px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            Button { text: "GitHub"; clicked => { root.docs-open-github(); } }
                                            if root.doc-video-available: Button { text: "Video"; clicked => { root.docs-open-video(); } }
                                            Button { text: "Close"; clicked => { root.docs-visible = false; } }
                                        }
                                    }
                                    ScrollView { Text { x: 22px; y: 20px; width: parent.width - 44px; text: root.doc-content; color: #cbd2cd; font-size: 13px; wrap: word-wrap; } }
                                    Rectangle {
                                        height: 54px; background: #181b19; border-width: 1px; border-color: #303532;
                                        HorizontalLayout {
                                            padding: 8px; spacing: 7px;
                                            Button { text: "First"; enabled: root.doc-page > 1; clicked => { root.docs-navigate(0); } }
                                            Button { text: "Previous"; enabled: root.doc-page > 1; clicked => { root.docs-navigate(-1); } }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            Text { text: "Page " + root.doc-page + " of " + root.doc-total; color: #adb5b0; font-size: 12px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            Button { text: "Next"; enabled: root.doc-page < root.doc-total; clicked => { root.docs-navigate(1); } }
                                            Button { text: "Last"; enabled: root.doc-page < root.doc-total; clicked => { root.docs-navigate(2); } }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 38px;
                            background: #222c23;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text { text: root.selection-mode == 0 ? "BOX  X " + root.min-x + ".." + root.max-x + "  ·  Y " + root.min-y + ".." + root.max-y + "  ·  Z " + root.min-z + ".." + root.max-z : "BUBBLE  center " + root.center-x + "," + root.center-y + "," + root.center-z + "  ·  radius " + root.radius-x + "," + root.radius-y + "," + root.radius-z; color: #d7ddd9; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                if root.viewport-mode == 0 && root.map-available: Text { text: root.map-cursor-label; color: #d2d8d4; font-size: 11px; font-family: "monospace"; font-weight: 700; vertical-alignment: center; }
                                if root.viewport-mode == 1 && root.preview-available: Text { text: "3D BOX · A/B"; color: #9ac7a2; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 40px;
                background: root.task-failed ? #30251b : #17221c;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 10px;
                    Text {
                        text: root.task-failed ? "Needs attention · " + root.task-detail : root.foreground-busy ? root.task-detail : root.task-title == "EXPORT COMPLETE" ? "Export saved · See Export for the file details" : root.world-selected ? "Ready · " + root.world-name : "Start by opening a Minecraft world";
                        color: root.task-failed ? #efcc8a : #c7d9cc;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button { text: "View activity"; clicked => { root.active-activity = 3; } }
                }
            }
        }

        task-loader := MinesportLoader {
            width: min(520px, parent.width - 36px);
            height: 82px;
            x: parent.width - self.width - 18px;
            y: parent.height - self.height - 18px;
            active: root.task-active && root.task-title != "EXPORT";
            complete-requested: false;
            visible: root.task-active && root.task-title != "EXPORT";
            title: root.task-title;
            detail: root.task-detail;
            progress: root.task-progress;
            determinate: true;
            compact: true;
        }

        if root.settings-visible: Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            background: #0000009e;
            TouchArea { mouse-cursor: default; }

            Rectangle {
                width: min(760px, parent.width - 80px);
                height: min(700px, parent.height - 80px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #1b1e1c;
                border-width: 1px;
                border-color: #4a514c;
                border-radius: 8px;

                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 52px;
                        background: #202320;
                        border-width: 1px;
                        border-color: #363c38;
                        HorizontalLayout {
                            padding-left: 18px; padding-right: 10px;
                            Text { text: "SETTINGS"; color: #f0f3f0; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: "Changes save immediately"; color: #a5aea8; font-size: 12px; vertical-alignment: center; }
                            Button { text: "Close"; clicked => { root.settings-visible = false; } }
                        }
                    }
                    ScrollView {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 11px;
                            SectionTitle { label: "GENERAL"; }
                            CheckBox { text: "Blender integration"; checked <=> root.blender-export; toggled => { root.export-preset-index = 0; root.settings-changed(); } }
                            HintText { text: "Prepare exported models for the Minesport Blender translator. This setting is ignored for Litematica."; }
                            Button { text: "Open documentation"; clicked => { root.open-docs(); root.settings-visible = false; } }
                            CheckBox { text: "Show advanced settings"; checked <=> root.advanced-settings-visible; }
                            if root.advanced-settings-visible: VerticalLayout {
                            spacing: 11px;
                            if root.export-format-index == 2: HintText { text: "Litematica exports block states directly; 3D geometry and runtime-model settings are not used."; }
                            if root.export-format-index < 2: VerticalLayout {
                                spacing: 11px;
                                SectionTitle { label: "GEOMETRY"; }
                            CheckBox { text: "Face culling"; checked <=> root.face-culling; toggled => { root.export-preset-index = 0; root.settings-changed(); } }
                            HintText { text: "Remove a face only when neighboring geometry and its resolved texture prove that the face is fully hidden."; }
                            CheckBox { text: "FLATTER geometry · Experimental"; checked <=> root.flatter-enabled; toggled => { root.export-preset-index = 0; root.settings-changed(); } }
                            ComboBox { model: ["8 × 8 × 8", "16 × 16 × 16", "32 × 32 × 32", "64 × 64 × 64"]; current-index <=> root.flatter-cell-index; enabled: root.flatter-enabled; selected(_) => { root.export-preset-index = 0; root.settings-changed(); } }
                            HintText { text: "Controls the spatial FLATTER cell. Smaller cells rebuild more locally; larger cells create fewer objects and broader greedy surfaces."; }
                            CheckBox { text: "Hidden block culling · Experimental"; checked <=> root.hidden-culling; toggled => { root.export-preset-index = 0; root.settings-changed(); } }
                                CheckBox { text: "Select by model · Experimental"; checked <=> root.select-by-model; toggled => { root.export-preset-index = 0; root.settings-changed(); } }
                            }
                            SectionTitle { label: "PIPELINE"; }
                            CheckBox { text: "Debug engine console"; checked <=> root.debug-mode; toggled => { root.settings-changed(); } }
                            if root.export-format-index < 2: VerticalLayout {
                                spacing: 8px;
                                Text { text: root.runtime-cache-status; color: #aab2ad; font-size: 12px; wrap: word-wrap; }
                                Button { text: "Rebuild full runtime registry"; enabled: root.world-path != "No world selected" && !root.foreground-busy; clicked => { root.rebuild-runtime-cache(); } }
                            }
                            if root.export-format-index < 2: VerticalLayout {
                                spacing: 11px;
                                SectionTitle { label: "ASSETS"; }
                            Text { text: root.resource-pack-summary; color: #a7b0aa; font-size: 12px; wrap: word-wrap; }
                            AssetEditor {
                                title: "Resource packs · highest priority first";
                                help: "Folders and ZIPs are resolved in this order before vanilla/mod fallback.";
                                items: root.resource-pack-items;
                                selected-index <=> root.resource-pack-selected;
                                allow-folder: true;
                                allow-file: true;
                                add-file => { root.add-resource-pack(); }
                                add-folder => { root.add-resource-pack-folder(); }
                                move-selected(delta) => { root.move-resource-pack(delta); }
                                remove-selected => { root.remove-resource-pack(); }
                            }
                            Text { text: root.data-pack-summary; color: #a7b0aa; font-size: 12px; wrap: word-wrap; }
                            AssetEditor {
                                title: "Data packs · block tags";
                                help: "Data-pack paths are forwarded to the engine for tag/state resolution.";
                                items: root.data-pack-items;
                                selected-index <=> root.data-pack-selected;
                                allow-folder: true;
                                allow-file: false;
                                add-folder => { root.add-data-pack(); }
                                move-selected(delta) => { root.move-data-pack(delta); }
                                remove-selected => { root.remove-data-pack(); }
                                }
                            }
                            SectionTitle { label: "ADVANCED EXPORT TOOLS"; }
                            Button { text: "Run manual preflight"; enabled: root.world-path != "No world selected" && !root.foreground-busy; clicked => { root.run-preflight(); } }
                            Text { text: root.preflight-summary; color: #a7b0aa; font-size: 12px; wrap: word-wrap; }
                            Button { text: "Reload 2D map"; enabled: root.world-path != "No world selected" && !root.map-loading && !root.foreground-busy; clicked => { root.reload-map(); } }
                            Button { text: "Remove all Minesport cache"; enabled: !root.foreground-busy; clicked => { root.remove-cache(); } }
                            HintText { text: "Deletes only regenerable runtime/cache/toolchain data. Worlds, exports, settings and real mods are never touched."; }
                            }
                        }
                    }
                }
            }
        }

        if root.blender-prompt-visible: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #000000a8;

            TouchArea { mouse-cursor: default; }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(560px, parent.width - 48px);
                height: 238px;
                background: #1e1f1d;
                border-width: 1px;
                border-color: #454b47;
                border-radius: 7px;

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    Text { text: "Blender integration"; color: #f0f3f0; font-size: 16px; font-weight: 700; }
                    Rectangle { height: 1px; background: #3a403c; }
                    Text { text: root.blender-prompt-message; color: #c7cec9; font-size: 13px; wrap: word-wrap; vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button { text: "Not now"; clicked => { root.blender-prompt-later(); } }
                        Button { text: "Install"; primary: true; enabled: !root.foreground-busy; clicked => { root.blender-prompt-install(); } }
                    }
                }
            }
        }
    }
}
