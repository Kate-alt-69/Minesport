import { Button, CheckBox, ComboBox, LineEdit, ProgressIndicator, ScrollView, SpinBox, Spinner } from "std-widgets.slint";

component RailButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    width: 62px;
    height: 56px;
    background: active ? #19252e : hit.has-hover ? #141d24 : transparent;
    border-width: active ? 2px : 0px;
    border-color: #59a676;

    Text {
        text: root.label;
        color: root.active ? #f2f6f8 : #8192a2;
        font-size: 9px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SectionTitle inherits Text {
    in property <string> label;
    text: label;
    height: 21px;
    color: #758697;
    font-size: 10px;
    font-weight: 700;
    vertical-alignment: center;
}

component HintText inherits Text {
    color: #738494;
    font-size: 10px;
    wrap: word-wrap;
}

component Surface inherits Rectangle {
    background: #121a20;
    border-width: 1px;
    border-color: #26343f;
    border-radius: 6px;
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <bool> good;
    height: 28px;
    width: 122px;
    border-radius: 5px;
    background: good ? #153424 : #382326;
    border-width: 1px;
    border-color: good ? #2f7553 : #713942;
    Text {
        text: root.label;
        color: root.good ? #8be0b2 : #f0a7ae;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component MainWindow inherits Window {
    title: "Minesport 0.2.0 — by Kastrick";
    preferred-width: 1360px;
    preferred-height: 820px;
    min-width: 1060px;
    min-height: 680px;
    background: #0b1015;

    // Workbench navigation --------------------------------------------------
    // 0 World · 1 Export · 2 Blender · 3 Tasks · 4 Settings
    in-out property <int> active-activity: 0;
    // Settings: 0 Geometry · 1 Pipeline · 2 Assets · 3 Advanced · 4 Diagnostics
    in-out property <int> settings-page: 0;
    // 0 map · 1 preview
    in-out property <int> viewport-mode: 0;

    // World / selection -----------------------------------------------------
    in-out property <string> world-path: "No world selected";
    in-out property <string> world-name: "No world selected";
    in-out property <string> minecraft-version: "—";
    in-out property <string> loader-type: "—";
    in-out property <int> selection-mode: 0;
    in-out property <int> min-x: -256;
    in-out property <int> min-y: -64;
    in-out property <int> min-z: -256;
    in-out property <int> max-x: 256;
    in-out property <int> max-y: 320;
    in-out property <int> max-z: 256;
    in-out property <int> center-x: 0;
    in-out property <int> center-y: 64;
    in-out property <int> center-z: 0;
    in-out property <int> radius-x: 32;
    in-out property <int> radius-y: 32;
    in-out property <int> radius-z: 32;

    // 2D map ---------------------------------------------------------------
    in-out property <image> map-image;
    in-out property <bool> map-available: false;
    in-out property <bool> map-loading: false;
    in-out property <int> map-min-x: -256;
    in-out property <int> map-min-z: -256;
    in-out property <int> map-max-x: 256;
    in-out property <int> map-max-z: 256;
    in-out property <int> map-scale: 1;
    in-out property <string> map-cursor-label: "X —  ·  Z —";

    // Rust preview ----------------------------------------------------------
    in-out property <image> preview-image;
    in-out property <bool> preview-available: false;
    in-out property <bool> preview-loading: false;
    in-out property <int> preview-block-count: 0;

    // Export ---------------------------------------------------------------
    in-out property <string> output-path: "";
    in-out property <string> export-name: "Minesport_Export";
    in-out property <int> export-format-index: 0;
    in-out property <int> export-mode-index: 0;
    in-out property <bool> optimize: true;
    in-out property <string> preflight-summary: "Preflight has not been run for this selection.";

    // Persistent settings --------------------------------------------------
    in-out property <bool> face-culling: true;
    in-out property <bool> flatter-enabled: true;
    in-out property <int> flatter-cell-index: 3;
    in-out property <bool> hidden-culling: false;
    in-out property <bool> blender-export: true;
    in-out property <bool> select-by-model: false;
    in-out property <bool> debug-mode: false;
    in-out property <int> blender-animation-index: 0;
    in-out property <string> resource-pack-summary: "No resource-pack overrides";
    in-out property <string> data-pack-summary: "No data-pack overrides";

    // Runtime / task --------------------------------------------------------
    in-out property <string> engine-status: "STARTING";
    in-out property <bool> engine-ready: false;
    in-out property <string> runtime-cache-status: "WAITING FOR WORLD";
    in-out property <bool> runtime-cache-busy: false;
    in-out property <string> task-title: "IDLE";
    in-out property <string> task-detail: "Ready";
    in-out property <float> task-progress: 0.0;
    in-out property <bool> task-active: false;
    in-out property <string> diagnostics: "Minesport Rust/Slint desktop initialized.";

    // Documentation --------------------------------------------------------
    in-out property <bool> docs-visible: false;
    in-out property <int> doc-page: 1;
    in-out property <int> doc-total: 8;
    in-out property <string> doc-title: "Start Here";
    in-out property <string> doc-content: "Open Documentation from Settings to load the Minesport manual.";
    in-out property <bool> doc-video-available: false;

    callback pick-world();
    callback pick-output();
    callback reload-map();
    callback export-requested();
    callback run-preflight();
    callback open-3d();
    callback rebuild-runtime-cache();
    callback cancel-runtime-cache();
    callback remove-cache();
    callback add-resource-pack();
    callback add-data-pack();
    callback install-blender-translator();
    callback open-docs();
    callback docs-navigate(int);
    callback docs-open-github();
    callback docs-open-video();

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 52px;
            background: #10171d;
            border-width: 1px;
            border-color: #202c36;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Text {
                    text: "MINESPORT";
                    color: #f1f5f7;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: "0.2.0  ·  RUST + SLINT  ·  KASTRICK";
                    color: #718292;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: root.world-path == "No world selected" ? "NO WORLD" : root.world-name + "  ·  " + root.minecraft-version + "  ·  " + root.loader-type;
                    color: #93a2b1;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 480px;
                }
                StatusPill { label: root.engine-status; good: root.engine-ready; }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            Rectangle {
                width: 62px;
                background: #0d1318;
                border-width: 1px;
                border-color: #202b35;
                VerticalLayout {
                    spacing: 0px;
                    RailButton { label: "WORLD"; active: root.active-activity == 0; clicked => { root.active-activity = 0; } }
                    RailButton { label: "EXPORT"; active: root.active-activity == 1; clicked => { root.active-activity = 1; } }
                    RailButton { label: "BLENDER"; active: root.active-activity == 2; clicked => { root.active-activity = 2; } }
                    RailButton { label: "TASKS"; active: root.active-activity == 3; clicked => { root.active-activity = 3; } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    RailButton { label: "SETTINGS"; active: root.active-activity == 4; clicked => { root.active-activity = 4; } }
                }
            }

            Rectangle {
                width: 330px;
                background: #12181e;
                border-width: 1px;
                border-color: #202b35;
                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 42px;
                        background: #141c23;
                        border-width: 1px;
                        border-color: #24313c;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            Text {
                                text: root.active-activity == 0 ? "WORLD"
                                    : root.active-activity == 1 ? "EXPORT"
                                    : root.active-activity == 2 ? "BLENDER"
                                    : root.active-activity == 3 ? "TASKS"
                                    : "SETTINGS";
                                color: #e1e7ec;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            if root.active-activity == 4: Button { text: "DOCS"; clicked => { root.open-docs(); } }
                        }
                    }

                    if root.active-activity == 0: ScrollView {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 9px;
                            Text { text: root.world-name; color: #eef2f5; font-size: 14px; font-weight: 700; overflow: elide; }
                            Text { text: root.world-path; color: #758696; font-size: 10px; wrap: word-wrap; }
                            Text { text: root.minecraft-version + "  ·  " + root.loader-type; color: #6da5d5; font-size: 10px; }
                            Button { text: "OPEN MINECRAFT WORLD…"; primary: true; clicked => { root.pick-world(); } }

                            SectionTitle { label: "SELECTION"; }
                            ComboBox { model: ["Box selection", "Bubble selection"]; current-index <=> root.selection-mode; }

                            if root.selection-mode == 0: VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout { spacing: 6px; Text { width: 30px; text: "X"; color: #8796a5; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.min-x; } Text { text: "→"; color: #627384; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.max-x; } }
                                HorizontalLayout { spacing: 6px; Text { width: 30px; text: "Y"; color: #8796a5; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -2048; maximum: 4096; value <=> root.min-y; } Text { text: "→"; color: #627384; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -2048; maximum: 4096; value <=> root.max-y; } }
                                HorizontalLayout { spacing: 6px; Text { width: 30px; text: "Z"; color: #8796a5; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.min-z; } Text { text: "→"; color: #627384; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.max-z; } }
                            }

                            if root.selection-mode == 1: VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Center X"; color: #8796a5; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.center-x; } }
                                HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Center Y"; color: #8796a5; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -2048; maximum: 4096; value <=> root.center-y; } }
                                HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Center Z"; color: #8796a5; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: -30000000; maximum: 30000000; value <=> root.center-z; } }
                                Rectangle { height: 1px; background: #27333e; }
                                HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Radius X"; color: #8796a5; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: 1; maximum: 30000000; value <=> root.radius-x; } }
                                HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Radius Y"; color: #8796a5; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: 1; maximum: 4096; value <=> root.radius-y; } }
                                HorizontalLayout { spacing: 6px; Text { width: 70px; text: "Radius Z"; color: #8796a5; vertical-alignment: center; } SpinBox { horizontal-stretch: 1; minimum: 1; maximum: 30000000; value <=> root.radius-z; } }
                            }

                            Button {
                                text: "USE WORLD BOUNDS";
                                enabled: root.map-available;
                                clicked => {
                                    root.min-x = root.map-min-x;
                                    root.max-x = root.map-max-x;
                                    root.min-z = root.map-min-z;
                                    root.max-z = root.map-max-z;
                                }
                            }
                            HintText { text: "Drag the 2D map for a box. Bubble mode uses a map click as its X/Z center. Y stays editable here."; }
                            SectionTitle { label: "RUNTIME REGISTRY"; }
                            Text { text: root.runtime-cache-status; color: root.runtime-cache-busy ? #d2b777 : #86a997; font-size: 10px; wrap: word-wrap; }
                            if root.runtime-cache-busy: Button { text: "CANCEL PREPARATION"; clicked => { root.cancel-runtime-cache(); } }
                        }
                    }

                    if root.active-activity == 1: ScrollView {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 9px;
                            SectionTitle { label: "OUTPUT"; }
                            Text { text: "Name"; color: #8191a0; font-size: 10px; }
                            LineEdit { text <=> root.export-name; }
                            Text { text: "Format"; color: #8191a0; font-size: 10px; }
                            ComboBox { model: ["glTF 2.0", "OBJ + MTL"]; current-index <=> root.export-format-index; }
                            Text { text: "Objects"; color: #8191a0; font-size: 10px; }
                            ComboBox { model: ["Grouped", "Individual blocks", "Merged"]; current-index <=> root.export-mode-index; }
                            CheckBox { text: "Optimize mesh output"; checked <=> root.optimize; }
                            Text { text: root.output-path == "" ? "~/Minesport_Exports" : root.output-path; color: #758696; font-size: 10px; wrap: word-wrap; }
                            Button { text: "CHOOSE OUTPUT FOLDER…"; clicked => { root.pick-output(); } }

                            SectionTitle { label: "ANALYSIS"; }
                            Text { text: root.preflight-summary; color: #8da0af; font-size: 10px; wrap: word-wrap; }
                            Button { text: "RUN PREFLIGHT"; enabled: root.engine-ready && !root.task-active && root.world-path != "No world selected"; clicked => { root.run-preflight(); } }

                            SectionTitle { label: "EXPORT"; }
                            Button {
                                text: root.task-active ? "WORKING…" : "EXPORT WORLD";
                                primary: true;
                                enabled: root.engine-ready && !root.task-active && root.world-path != "No world selected";
                                clicked => { root.export-requested(); }
                            }
                            HintText { text: "Export waits for the same instance-wide registry worker when needed, then continues automatically."; }
                        }
                    }

                    if root.active-activity == 2: ScrollView {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 9px;
                            SectionTitle { label: "BLENDER TRANSLATOR"; }
                            CheckBox { text: "Blender integration"; checked <=> root.blender-export; }
                            Button { text: "INSTALL / UPDATE ADD-ON"; enabled: !root.task-active; clicked => { root.install-blender-translator(); } }
                            Text { text: "Texture animation"; color: #8191a0; font-size: 10px; }
                            ComboBox { model: ["Minecraft timing", "Static first frame"]; current-index <=> root.blender-animation-index; }
                            HintText { text: "The Rust executable embeds the Minesport 0.2.0 translator and installs it into detected Blender 4.3+ profiles."; }
                            SectionTitle { label: "MINECRAFT DATA"; }
                            HintText { text: "Texture frame schedules, Timeline markers, LIGHT_BLOCK levels, FLATTER data, water/glass material metadata and individual-block origins travel with the export."; }
                        }
                    }

                    if root.active-activity == 3: ScrollView {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 9px;
                            SectionTitle { label: "ACTIVE TASK"; }
                            Text { text: root.task-title; color: #e4e9ed; font-size: 13px; font-weight: 700; }
                            Text { text: root.task-detail; color: #7e8f9f; font-size: 10px; wrap: word-wrap; }
                            if root.task-active: ProgressIndicator { progress: root.task-progress; }
                            SectionTitle { label: "RUNTIME REGISTRY"; }
                            Text { text: root.runtime-cache-status; color: #8fa2b4; font-size: 10px; wrap: word-wrap; }
                            if root.runtime-cache-busy: Button { text: "CANCEL RUNTIME WORKER"; clicked => { root.cancel-runtime-cache(); } }
                            HintText { text: "Heavy parsing, hashing, Java IPC and Minecraft worker processes stay outside the Slint event loop."; }
                        }
                    }

                    if root.active-activity == 4: VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 42px;
                            background: #10171d;
                            HorizontalLayout {
                                padding: 5px;
                                spacing: 2px;
                                Button { text: "GEO"; checkable: true; checked: root.settings-page == 0; clicked => { root.settings-page = 0; } }
                                Button { text: "PIPE"; checkable: true; checked: root.settings-page == 1; clicked => { root.settings-page = 1; } }
                                Button { text: "ASSET"; checkable: true; checked: root.settings-page == 2; clicked => { root.settings-page = 2; } }
                                Button { text: "ADV"; checkable: true; checked: root.settings-page == 3; clicked => { root.settings-page = 3; } }
                                Button { text: "LOG"; checkable: true; checked: root.settings-page == 4; clicked => { root.settings-page = 4; } }
                            }
                        }

                        ScrollView {
                            if root.settings-page == 0: VerticalLayout {
                                padding: 14px;
                                spacing: 9px;
                                SectionTitle { label: "GEOMETRY"; }
                                CheckBox { text: "Face culling"; checked <=> root.face-culling; }
                                HintText { text: "Remove faces only when neighboring geometry proves they are fully hidden."; }
                                CheckBox { text: "FLATTER geometry · Experimental"; checked <=> root.flatter-enabled; }
                                ComboBox { model: ["8 × 8 × 8", "16 × 16 × 16", "32 × 32 × 32", "64 × 64 × 64"]; current-index <=> root.flatter-cell-index; enabled: root.flatter-enabled; }
                                CheckBox { text: "Hidden block culling · Experimental"; checked <=> root.hidden-culling; }
                                CheckBox { text: "Select by model · Experimental"; checked <=> root.select-by-model; }
                            }

                            if root.settings-page == 1: VerticalLayout {
                                padding: 14px;
                                spacing: 9px;
                                SectionTitle { label: "PIPELINE"; }
                                CheckBox { text: "Blender integration"; checked <=> root.blender-export; }
                                CheckBox { text: "Debug engine diagnostics"; checked <=> root.debug-mode; }
                                Text { text: "Full runtime model registry"; color: #c5d0d9; font-size: 11px; font-weight: 700; }
                                Text { text: root.runtime-cache-status; color: #7f91a3; font-size: 10px; wrap: word-wrap; }
                                Button { text: "REBUILD FULL RUNTIME REGISTRY"; enabled: root.world-path != "No world selected" && !root.runtime-cache-busy; clicked => { root.rebuild-runtime-cache(); } }
                                if root.runtime-cache-busy: Button { text: "CANCEL"; clicked => { root.cancel-runtime-cache(); } }
                            }

                            if root.settings-page == 2: VerticalLayout {
                                padding: 14px;
                                spacing: 9px;
                                SectionTitle { label: "ASSET RESOLUTION"; }
                                Text { text: root.resource-pack-summary; color: #8798a8; font-size: 10px; wrap: word-wrap; }
                                Button { text: "ADD RESOURCE PACK…"; clicked => { root.add-resource-pack(); } }
                                Text { text: root.data-pack-summary; color: #8798a8; font-size: 10px; wrap: word-wrap; }
                                Button { text: "ADD DATA PACK…"; clicked => { root.add-data-pack(); } }
                                HintText { text: "Rust stores selected paths and preserves Java resolver precedence when sending export/preflight requests."; }
                            }

                            if root.settings-page == 3: VerticalLayout {
                                padding: 14px;
                                spacing: 9px;
                                SectionTitle { label: "ADVANCED"; }
                                Button { text: "RUN PREFLIGHT"; enabled: root.world-path != "No world selected" && !root.task-active; clicked => { root.run-preflight(); } }
                                Text { text: root.preflight-summary; color: #8193a3; font-size: 10px; wrap: word-wrap; }
                                Button { text: "RELOAD 2D MAP"; enabled: root.world-path != "No world selected" && !root.map-loading; clicked => { root.reload-map(); } }
                                Button { text: "OPEN DOCUMENTATION"; clicked => { root.open-docs(); } }
                                SectionTitle { label: "DIAGNOSTICS"; }
                                Button { text: "REMOVE ALL MINESPORT CACHE"; enabled: !root.task-active && !root.runtime-cache-busy; clicked => { root.remove-cache(); } }
                                HintText { text: "Deletes only regenerable Minesport cache data. Worlds, exports and the real mods folder are never touched."; }
                            }

                            if root.settings-page == 4: VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                SectionTitle { label: "DIAGNOSTICS"; }
                                Surface {
                                    height: 510px;
                                    ScrollView {
                                        Text {
                                            x: 10px;
                                            y: 10px;
                                            width: parent.width - 20px;
                                            text: root.diagnostics;
                                            color: #9cadbd;
                                            font-size: 9px;
                                            font-family: "monospace";
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: #0b1015;
                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 42px;
                        background: #11181f;
                        border-width: 1px;
                        border-color: #222e38;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 8px;
                            Text {
                                text: root.viewport-mode == 0 ? "2D world map · drag to select" : "Rust 3D preview · rendered off-thread";
                                color: #758696;
                                font-size: 9px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button { text: "2D"; checkable: true; checked: root.viewport-mode == 0; clicked => { root.viewport-mode = 0; } }
                            Button { text: "3D"; checkable: true; checked: root.viewport-mode == 1; enabled: root.world-path != "No world selected"; clicked => { root.viewport-mode = 1; root.open-3d(); } }
                            if root.viewport-mode == 1: Button { text: "REFRESH"; enabled: !root.preview-loading; clicked => { root.open-3d(); } }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: #0c1217;

                        if root.viewport-mode == 0: Rectangle {
                            background: #0c1217;
                            if root.map-available: Image {
                                source: root.map-image;
                                image-fit: fill;
                                width: parent.width;
                                height: parent.height;
                            }
                            if !root.map-available && !root.map-loading: Text {
                                text: root.world-path == "No world selected" ? "SELECT A MINECRAFT WORLD" : "NO 2D MAP LOADED";
                                color: #566777;
                                font-size: 16px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.map-loading: VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                Spinner { width: 34px; height: 34px; indeterminate: true; }
                                Text { text: "Loading chunks…"; color: #a6b4c0; font-size: 12px; horizontal-alignment: center; }
                                Text { text: "Java prepares the map while Slint stays interactive."; color: #607181; font-size: 9px; horizontal-alignment: center; }
                            }

                            map-touch := TouchArea {
                                enabled: root.map-available && !root.docs-visible;
                                mouse-cursor: crosshair;
                                pointer-event(event) => {
                                    root.map-cursor-label = "X " + round(root.map-min-x + self.mouse-x / self.width * (root.map-max-x - root.map-min-x))
                                        + "  ·  Z " + round(root.map-min-z + self.mouse-y / self.height * (root.map-max-z - root.map-min-z));
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                        if (root.selection-mode == 0) {
                                            root.min-x = round(root.map-min-x + min(self.pressed-x, self.mouse-x) / self.width * (root.map-max-x - root.map-min-x));
                                            root.max-x = round(root.map-min-x + max(self.pressed-x, self.mouse-x) / self.width * (root.map-max-x - root.map-min-x));
                                            root.min-z = round(root.map-min-z + min(self.pressed-y, self.mouse-y) / self.height * (root.map-max-z - root.map-min-z));
                                            root.max-z = round(root.map-min-z + max(self.pressed-y, self.mouse-y) / self.height * (root.map-max-z - root.map-min-z));
                                        } else {
                                            root.center-x = round(root.map-min-x + self.mouse-x / self.width * (root.map-max-x - root.map-min-x));
                                            root.center-z = round(root.map-min-z + self.mouse-y / self.height * (root.map-max-z - root.map-min-z));
                                        }
                                    }
                                }
                                moved => {
                                    root.map-cursor-label = "X " + round(root.map-min-x + self.mouse-x / self.width * (root.map-max-x - root.map-min-x))
                                        + "  ·  Z " + round(root.map-min-z + self.mouse-y / self.height * (root.map-max-z - root.map-min-z));
                                }
                            }

                            if map-touch.pressed && root.selection-mode == 0: Rectangle {
                                x: min(map-touch.pressed-x, map-touch.mouse-x);
                                y: min(map-touch.pressed-y, map-touch.mouse-y);
                                width: max(1px, max(map-touch.pressed-x, map-touch.mouse-x) - min(map-touch.pressed-x, map-touch.mouse-x));
                                height: max(1px, max(map-touch.pressed-y, map-touch.mouse-y) - min(map-touch.pressed-y, map-touch.mouse-y));
                                background: #3e8f6240;
                                border-width: 1px;
                                border-color: #7ce0a3;
                            }

                            if root.map-available: Rectangle {
                                x: parent.width - 170px;
                                y: parent.height - 42px;
                                width: 158px;
                                height: 30px;
                                background: #101820dd;
                                border-width: 1px;
                                border-color: #2a3945;
                                border-radius: 5px;
                                Text {
                                    text: root.map-cursor-label;
                                    color: #a0aebb;
                                    font-size: 9px;
                                    font-family: "monospace";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.viewport-mode == 1: Rectangle {
                            background: #0c1217;
                            if root.preview-available: Image {
                                source: root.preview-image;
                                image-fit: contain;
                                width: parent.width;
                                height: parent.height;
                            }
                            if root.preview-loading: VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                Spinner { width: 34px; height: 34px; indeterminate: true; }
                                Text { text: "Rendering 3D preview…"; color: #a8b5c0; font-size: 12px; horizontal-alignment: center; }
                                Text { text: "Block parsing and rasterization run outside the Slint event loop."; color: #607181; font-size: 9px; horizontal-alignment: center; }
                            }
                            if !root.preview-available && !root.preview-loading: VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                Text { text: "3D PREVIEW"; color: #91a2b1; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "Generate a lightweight Rust preview for the current selection."; color: #607181; font-size: 10px; horizontal-alignment: center; }
                                Button { text: "GENERATE PREVIEW"; clicked => { root.open-3d(); } }
                            }
                            if root.preview-available: Rectangle {
                                x: 12px;
                                y: 12px;
                                width: 170px;
                                height: 30px;
                                border-radius: 5px;
                                background: #101820dd;
                                border-width: 1px;
                                border-color: #2a3945;
                                Text { text: root.preview-block-count + " blocks"; color: #a7b6c3; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }

                        if root.docs-visible: Rectangle {
                            background: #0d1319f8;
                            border-width: 1px;
                            border-color: #2b3945;
                            VerticalLayout {
                                spacing: 0px;
                                Rectangle {
                                    height: 48px;
                                    background: #121b22;
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 10px;
                                        Text { text: "DOCUMENTATION  ·  Page " + root.doc-page + " of " + root.doc-total + "  ·  " + root.doc-title; color: #eef2f5; font-size: 12px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Button { text: "GITHUB"; clicked => { root.docs-open-github(); } }
                                        if root.doc-video-available: Button { text: "VIDEO"; clicked => { root.docs-open-video(); } }
                                        Button { text: "CLOSE"; clicked => { root.docs-visible = false; } }
                                    }
                                }
                                ScrollView {
                                    Text {
                                        x: 20px;
                                        y: 18px;
                                        width: parent.width - 40px;
                                        text: root.doc-content;
                                        color: #b8c4ce;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                                Rectangle {
                                    height: 52px;
                                    background: #111920;
                                    border-width: 1px;
                                    border-color: #27343f;
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 7px;
                                        Button { text: "FIRST"; enabled: root.doc-page > 1; clicked => { root.docs-navigate(0); } }
                                        Button { text: "PREVIOUS"; enabled: root.doc-page > 1; clicked => { root.docs-navigate(-1); } }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: "Page " + root.doc-page + " of " + root.doc-total; color: #8fa0af; font-size: 10px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Button { text: "NEXT"; enabled: root.doc-page < root.doc-total; clicked => { root.docs-navigate(1); } }
                                        Button { text: "LAST"; enabled: root.doc-page < root.doc-total; clicked => { root.docs-navigate(2); } }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 34px;
                        background: #11181e;
                        border-width: 1px;
                        border-color: #222e38;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: root.selection-mode == 0
                                    ? "BOX  X " + root.min-x + ".." + root.max-x + "  ·  Y " + root.min-y + ".." + root.max-y + "  ·  Z " + root.min-z + ".." + root.max-z
                                    : "BUBBLE  center " + root.center-x + "," + root.center-y + "," + root.center-z + "  ·  radius " + root.radius-x + "," + root.radius-y + "," + root.radius-z;
                                color: #8c9cab;
                                font-size: 9px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            if root.viewport-mode == 0 && root.map-available: Text {
                                text: root.map-cursor-label;
                                color: #a0aebb;
                                font-size: 9px;
                                font-family: "monospace";
                                vertical-alignment: center;
                            }
                            if root.viewport-mode == 1 && root.preview-available: Text {
                                text: "RUST SOFTWARE PREVIEW";
                                color: #7ba58b;
                                font-size: 9px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: root.task-active ? 66px : 30px;
            background: root.task-active ? #131e18 : #0f161b;
            border-width: 1px;
            border-color: root.task-active ? #31563d : #202c35;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    if root.task-active: Spinner { width: 18px; height: 18px; indeterminate: true; }
                    Text { text: root.task-title; color: #dce5df; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                    Text { horizontal-stretch: 1; text: root.task-detail; color: #7f9185; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                }
                if root.task-active: ProgressIndicator { progress: root.task-progress; }
            }
        }
    }
}
