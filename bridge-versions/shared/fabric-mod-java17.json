{
  "schemaVersion": 1,
  "id": "minesport_bridge_fabric",
  "version": "${version}",
  "name": "Minesport Bridge (Fabric)",
  "description": "Dynamically prepared Minesport Fabric bridge for Minecraft ${minecraft_version}.",
  "authors": ["Kastrick"],
  "environment": "client",
  "entrypoints": {
    "client": ["dev.kastrick.minesport.bridge.MinesportBridge"]
  },
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17"
  },
  "suggests": {
    "polymer": "*"
  }
}
