{
  "schema": 1,
  "description": "Adapt the canonical 1.21.10 bridge to Minecraft 1.19 and 1.19.1 using modern Loom with the pre-1.19.2 Fabric API mod id.",
  "operations": [
    {"op": "set_property", "file": "gradle.properties", "key": "minecraft_version", "value": "${minecraft_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "loader_version", "value": "${loader_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "fabric_version", "value": "${fabric_api_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "loom_version", "value": "${loom_version}"},
    {"op": "replace", "file": "gradle/wrapper/gradle-wrapper.properties", "from": "gradle-8.14-bin.zip", "to": "gradle-${gradle_version}-bin.zip"},
    {"op": "overlay", "source": "bridge-versions/shared/build-java17-modernloom.gradle", "target": "build.gradle"},
    {"op": "overlay", "source": "bridge-versions/shared/fabric-mod-java17-pre1192.json", "target": "src/main/resources/fabric.mod.json"},
    {"op": "overlay", "source": "bridge-versions/1.19.0-1.19.2/overlays/MinesportBridge.java", "target": "src/client/java/dev/kastrick/minesport/bridge/MinesportBridge.java"},
    {"op": "overlay", "source": "bridge-versions/1.19.0-1.19.2/overlays/BlockGeometryExtractor.java", "target": "src/client/java/dev/kastrick/minesport/bridge/registry/BlockGeometryExtractor.java"},
    {"op": "overlay", "source": "bridge-versions/1.19.0-1.19.2/overlays/TextureExtractor.java", "target": "src/client/java/dev/kastrick/minesport/bridge/registry/TextureExtractor.java"}
  ]
}
