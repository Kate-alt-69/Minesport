{
  "schema": 1,
  "description": "Port the 1.21.10 Fabric bridge base to Minecraft 26.x with declarative renames plus only the rendering overlays that truly changed.",
  "operations": [
    {"op": "set_property", "file": "gradle.properties", "key": "minecraft_version", "value": "${minecraft_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "loader_version", "value": "${loader_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "fabric_api_version", "value": "${fabric_api_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "loom_version", "value": "${loom_version}"},
    {"op": "replace", "file": "gradle/wrapper/gradle-wrapper.properties", "from": "gradle-8.14-bin.zip", "to": "gradle-${gradle_version}-bin.zip"},
    {
      "op": "replace_tree",
      "root": "src",
      "extensions": [".java"],
      "from": "net.minecraft.resources.ResourceLocation",
      "to": "net.minecraft.resources.Identifier"
    },
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/26.x/overlays/build.gradle", "target": "build.gradle"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/26.x/overlays/MinesportBridge.java", "target": "src/client/java/dev/kastrick/minesport/bridge/MinesportBridge.java"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/26.x/overlays/BlockGeometryExtractor.java", "target": "src/client/java/dev/kastrick/minesport/bridge/registry/BlockGeometryExtractor.java"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/26.x/overlays/TextureExtractor.java", "target": "src/client/java/dev/kastrick/minesport/bridge/registry/TextureExtractor.java"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/26.x/overlays/fabric.mod.json", "target": "src/main/resources/fabric.mod.json"}
  ]
}
