{
  "schema": 1,
  "description": "Adapt the canonical 1.21.10 Fabric bridge to Minecraft 1.20.3 and 1.20.4 using the Java 17 Fabric/Loom 1.4 toolchain.",
  "operations": [
    {"op": "set_property", "file": "gradle.properties", "key": "minecraft_version", "value": "${minecraft_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "loader_version", "value": "${loader_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "fabric_version", "value": "${fabric_api_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "loom_version", "value": "${loom_version}"},
    {"op": "replace", "file": "gradle/wrapper/gradle-wrapper.properties", "from": "gradle-8.14-bin.zip", "to": "gradle-${gradle_version}-bin.zip"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/shared/build-java17.gradle", "target": "build.gradle"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/shared/fabric-mod-java17.json", "target": "src/main/resources/fabric.mod.json"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/1.21.0-1.21.4/overlays/BlockGeometryExtractor.java", "target": "src/client/java/dev/kastrick/minesport/bridge/registry/BlockGeometryExtractor.java"},
    {"op": "replace", "file": "src/client/java/dev/kastrick/minesport/bridge/MinesportBridge.java", "from": "net.minecraft.SharedConstants.getCurrentVersion().id()", "to": "net.minecraft.SharedConstants.getCurrentVersion().getId()"}
  ]
}
