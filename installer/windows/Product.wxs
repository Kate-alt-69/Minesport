<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Minesport"
      Language="1033"
      Version="0.1.1"
      Manufacturer="Kastrick"
      UpgradeCode="28E176EA-1E29-4EA0-B22A-BB77A9865AA8"
      InstallerVersion="500"
      Compressed="yes"
      Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Minesport is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="KastrickProgramFiles" Name="kastrick's_software">
        <Directory Id="INSTALLFOLDER" Name="minesport">
          <Component Id="MainExecutable" Guid="A4A7E0C8-2B1E-4D4E-9D1B-44A4B1F6C6A1">
            <File
                Id="MinesportExe"
                Source="$(var.SourceDir)\dist\source\Minesport.exe"
                Name="minesport.exe"
                KeyPath="yes">
              <Shortcut
                  Id="StartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="Minesport"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="yes" />
              <Shortcut
                  Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Minesport"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="yes" />
            </File>
          </Component>

          <Directory Id="TOOLS" Name="tools">
            <Component Id="BlenderInstallerHelper" Guid="F4D2A087-3E68-4B31-A7D0-2F60F23D9C6B">
              <File
                  Id="BlenderInstallScript"
                  Source="$(var.SourceDir)\installer\windows\install-blender.ps1"
                  KeyPath="yes" />
            </Component>
          </Directory>

          <Directory Id="BridgeDataDir" Name="bridge-data">
            <Component Id="BridgeManifest" Guid="*">
              <File
                  Id="BridgeManifestFile"
                  Source="$(var.SourceDir)\bridge-versions\manifest.json"
                  KeyPath="yes" />
            </Component>
            <Directory Id="BundledBridgeRoot" Name="bundled">
              <Directory Id="BundledBridge12110" Name="1.21.10">
                <Component Id="BundledBridge" Guid="*">
                  <File
                      Id="BundledBridgeJar"
                      Source="$(var.SourceDir)\dist\bundled-bridge\minesport-bridge-0.1.0.jar"
                      KeyPath="yes" />
                </Component>
              </Directory>
            </Directory>
            <Directory Id="CompiledBridgeDir" Name="compiled">
              <Component Id="CompiledBridgeCache" Guid="9C62E3D4-67A3-44C2-B0E5-2D68947E3F15">
                <CreateFolder>
                  <util:PermissionEx User="Users" GenericAll="yes" />
                </CreateFolder>
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="CoreFeature" Title="Minesport" Level="1" AllowAbsent="no">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="BridgeManifest" />
      <ComponentRef Id="BundledBridge" />
      <ComponentRef Id="CompiledBridgeCache" />
    </Feature>

    <Feature
        Id="BlenderFeature"
        Title="Install Blender 5.2 LTS"
        Description="Downloads Blender from the official Blender Foundation mirror and verifies its SHA-256 checksum."
        Level="2">
      <ComponentRef Id="BlenderInstallerHelper" />
    </Feature>

    <Feature
        Id="TranslatorFeature"
        Title="Minesport Blender translator"
        Description="Installs the one-shot Minesport translator into detected Blender 4.3+ profiles."
        Level="2">
      <ComponentRef Id="MainExecutable" />
    </Feature>

    <Property Id="INSTALLLEVEL" Value="1" />
    <ui:WixUI Id="WixUI_FeatureTree" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\installer\windows\license.rtf" />

    <CustomAction
        Id="InstallBlender"
        Directory="INSTALLFOLDER"
        ExeCommand='[SystemFolder]WindowsPowerShell\v1.0\powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[TOOLS]install-blender.ps1&quot;'
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <CustomAction
        Id="InstallTranslator"
        Directory="INSTALLFOLDER"
        ExeCommand='&quot;[INSTALLFOLDER]minesport.exe&quot; --install-blender-translator'
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom
          Action="InstallBlender"
          After="InstallFiles"
          Condition="NOT Installed AND (&amp;BlenderFeature=3)" />
      <Custom
          Action="InstallTranslator"
          After="InstallBlender"
          Condition="NOT Installed AND (&amp;TranslatorFeature=3)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
