{
  "schema": 1,
  "description": "Adapt the canonical 1.21.10 Fabric bridge to Minecraft 1.21.11, including the Identifier and baked-quad migrations.",
  "operations": [
    {"op": "set_property", "file": "gradle.properties", "key": "minecraft_version", "value": "${minecraft_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "loader_version", "value": "${loader_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "fabric_version", "value": "${fabric_api_version}"},
    {"op": "set_property", "file": "gradle.properties", "key": "loom_version", "value": "${loom_version}"},
    {"op": "replace", "file": "gradle/wrapper/gradle-wrapper.properties", "from": "gradle-8.14-bin.zip", "to": "gradle-${gradle_version}-bin.zip"},
    {"op": "replace_tree", "root": "src", "extensions": [".java"], "from": "net.minecraft.resources.ResourceLocation", "to": "net.minecraft.resources.Identifier"},
    {"op": "replace_tree", "root": "src", "extensions": [".java"], "from": "ResourceLocation", "to": "Identifier"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/shared/build-java21.gradle", "target": "build.gradle"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/shared/fabric-mod-java21.json", "target": "src/main/resources/fabric.mod.json"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/shared/ExportWorkerProtocolAnimated.java", "target": "src/main/java/dev/kastrick/minesport/bridge/model/ExportWorkerProtocol.java"},
    {"op": "overlay", "source": "minesport-bridge-fabric-versions/1.21.11/overlays/BlockGeometryExtractor.java", "target": "src/client/java/dev/kastrick/minesport/bridge/registry/BlockGeometryExtractor.java"}
  ]
}
